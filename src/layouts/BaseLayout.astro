---
import SiteChrome from "../components/SiteChrome.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { artist } from "../data/artist";
import "../styles/global.css";
import { getCopy, isLanguage, localeConfig, type Language } from "../i18n";
import { alternateLanguages, defaultPath, localizedPath, pageKeyForPath, pagePathForRequest } from "../i18n/routes";
import { sitePath, siteRelativePath } from "../site-paths";

interface Props { title?: string; lang?: Language; description?: string; current?: string }
const { title = "Rena Seulgi Jang", lang = "en", description = "" } = Astro.props;
const pathLanguage = siteRelativePath(Astro.url.pathname).split("/").filter(Boolean)[0];
if (pathLanguage && isLanguage(pathLanguage) && pathLanguage !== lang) {
  throw new Error(`Page language ${lang} does not match its route ${pathLanguage}`);
}
const content = getCopy(lang);
const copy = content.navigation;
const pageKey = pageKeyForPath(Astro.url.pathname);
const pagePath = pagePathForRequest(Astro.url.pathname);
const pageCopy = pageKey ? content[pageKey] : undefined;
const metaTitle = pageKey === "home" ? content.home.metaTitle
  : pageCopy && "title" in pageCopy ? `${pageCopy.title} | ${content.home.hero}` : title;
const metaDescription = description || pageCopy?.description || content.home.description;
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(localizedPath(lang, pagePath));
const alternates = alternateLanguages(pagePath);
const shareImage = absolute(sitePath("hero/portrait.jpg"));
const artistUrl = absolute(sitePath(""));
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Person", "@id": `${artistUrl}#artist`, name: artist.name,
      jobTitle: content.home.voice, url: artistUrl, image: shareImage,
      email: `mailto:${artist.email}`, sameAs: [artist.instagram, artist.youtube] },
    { "@type": "WebSite", "@id": `${artistUrl}#website`, url: artistUrl,
      name: artist.name, publisher: { "@id": `${artistUrl}#artist` } },
    { "@type": "WebPage", "@id": canonical, url: canonical, name: metaTitle,
      description: metaDescription, inLanguage: lang,
      isPartOf: { "@id": `${artistUrl}#website` }, about: { "@id": `${artistUrl}#artist` } },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#f7f3ec" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={sitePath("favicon.ico")} />
    <meta name="description" content={metaDescription} />
    <title>{metaTitle}</title>
    <link rel="canonical" href={canonical} />
    {alternates.map(code => <link rel="alternate" hreflang={code} href={absolute(localizedPath(code, pagePath))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(defaultPath(pagePath))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rena Seulgi Jang" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeConfig[lang].ogLocale} />
    {alternates.filter(code => code !== lang).map(code => <meta property="og:locale:alternate" content={localeConfig[code].ogLocale} />)}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1638" />
    <meta property="og:image:height" content="2048" />
    <meta property="og:image:alt" content={content.home.portrait} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    <meta name="google-site-verification" content="QIzUIHniwwNlJRuJ789uRDNLT4B8il1CvzqdE2pQzqw" />
  </head>

  <body id="site-top">
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <SiteChrome lang={lang} />
    <main class="page" id="main-content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter lang={lang} />
  </body>
</html>
