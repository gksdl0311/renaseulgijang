---
const { title = "Rena Seulgi Jang", lang = "en", description = "" } = Astro.props;
import SiteChrome from "../components/SiteChrome.astro";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>

  <body>
    <SiteChrome lang={lang} />
    <main class="page">
      <slot />
    </main>

    <style>
      :global(:root) {
        --bg: #ffffff;
        --text: #111111;
        --muted: #6f6f6f;
        --rule: #d9d9d9;
        --hover: #111111;
      }

      :global(*) {
        box-sizing: border-box;
      }

      :global(html, body) {
        height: 100%;
        margin: 0;
        padding: 0;
        background: #ffffff;
      }

      :global(body) {
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
        color: var(--text);
        background: #ffffff;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      .page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 24px 18px 60px;
        background: #ffffff;
      }

      @media (max-width: 700px) {
        .page {
          padding: 18px 16px 40px;
        }
      }
    </style>
  </body>
</html>