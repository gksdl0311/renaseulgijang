---
const { title = "Rena Seulgi Jang", lang = "en", description = "" } = Astro.props;
import SiteChrome from "../components/SiteChrome.astro";
import { navigationCopy } from "../i18n/navigation";
import type { Language } from "../i18n";
import { sitePath } from "../site-paths";
const copy = navigationCopy[lang as Language] ?? navigationCopy.en;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={sitePath("favicon.ico")} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
 <meta name="google-site-verification" content="QIzUIHniwwNlJRuJ789uRDNLT4B8il1CvzqdE2pQzqw" />
  </head>

  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <SiteChrome lang={lang} />
    <main class="page" id="main-content" tabindex="-1">
      <slot />
    </main>

    <style>
      :global(:root) {
        --bg: #ffffff;
        --text: #111111;
        --muted: #6f6f6f;
        --rule: #d9d9d9;
        --hover: #111111;
      }

      :global(*) {
        box-sizing: border-box;
      }

      :global(html, body) {
        min-height: 100%;
        margin: 0;
        padding: 0;
        background: #ffffff;
      }

      :global(html) {
        height: 100%;
      }

      :global(body) {
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
        color: var(--text);
        background: #ffffff;
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      :global(:focus-visible) {
        outline: 2px solid #333333;
        outline-offset: 4px;
      }

      :global(img, video) {
        max-width: 100%;
      }

      .skip-link {
        position: fixed;
        top: 8px;
        left: 12px;
        z-index: 100;
        padding: 12px 16px;
        background: #ffffff;
        border: 1px solid var(--text);
        transform: translateY(-180%);
      }

      .skip-link:focus {
        transform: none;
      }

      .page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 24px 18px 60px;
        background: #ffffff;
        min-width: 0;
      }

      @media (max-width: 700px) {
        :global(body) {
          font-size: 16px;
          line-height: 1.6;
        }

        .page {
          padding: 18px 16px 40px;
        }

        :global(.page :is(p, h1, h2, h3, a, li, td, th)) {
          overflow-wrap: anywhere;
        }

        :global(html[lang="ko"] .page) {
          word-break: keep-all;
        }
      }
    </style>
  </body>
</html>
