---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResponsiveImage from "../ResponsiveImage.astro";
import { getCopy, type Language } from "../../i18n";

interface Props { lang?: Language }
const { lang = "en" } = Astro.props;
const content = getCopy(lang);
const text = content.biography;
const copy = content.editorial.biography;
---

<BaseLayout lang={lang} current="biography" title={`${text.title} | Rena Seulgi Jang`}>
  <section class="biography-page shell" aria-labelledby="biography-title">
    <header class="biography-heading">
      <p class="eyebrow">{text.title}</p>
      <div class="artist-heading">
        <h1 id="biography-title">{content.home.name}</h1>
        <span class="voice-label">{content.home.voice}</span>
      </div>

      <div class="name-details">
        <p class="name-label">{copy.pronunciationHeading}</p>
        <div class="pronunciation-row">
          <span class="bio-pronunciation" lang="ko">[ɾe.na sɯl.ɡi tɕaŋ]</span>
          <span class="bio-guide" lang={text.guideLanguage}>{text.pronunciationGuide}</span>
          <button
            class="audio-button"
            type="button"
            aria-label={text.pronunciationLabel}
            aria-describedby="pronunciation-status"
            title={text.pronunciationTitle}
            hidden
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H3v6h3l5 4V5Z"></path>
              <path d="M15 9.5a4 4 0 0 1 0 5M17.5 7a7.5 7.5 0 0 1 0 10"></path>
            </svg>
          </button>
        </div>
        <p id="pronunciation-status" class="pronunciation-status" role="status" data-unavailable={text.pronunciationUnavailable} data-error={text.pronunciationError}>{text.pronunciationUnavailable}</p>
      </div>
    </header>

    <div class="biography-layout">
      <figure class="bio-portrait">
        <ResponsiveImage
          src="hero/portrait.jpg"
          alt={content.home.portrait}
          sizes="(min-width: 900px) 38vw, (min-width: 600px) 520px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="bio-portrait-image"
        />
        <figcaption>
          <span>{content.home.name}</span>
          <span>{content.home.voice}</span>
        </figcaption>
      </figure>
      <div class="bio-prose">
        {text.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <section class="biography-performance" aria-labelledby="performance-title">
      <div class="performance-copy">
        <p class="eyebrow">{copy.videoEyebrow}</p>
        <h2 id="performance-title">{copy.videoHeading}</h2>
        <p>{copy.videoIntro}</p>
        <a class="text-link" href="https://www.youtube.com/watch?v=WYXIK4-Rm4c" target="_blank" rel="noopener noreferrer">
          <span>{copy.videoExternal}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="performance-media" data-biography-video data-video-title={text.videoTitle} data-video-loading={copy.videoLoading}>
        <div class="film-stage">
          <button class="film-poster" type="button" data-load-biography-video aria-label={copy.videoPlay}>
            <span class="film-ornament" aria-hidden="true">R</span>
            <span class="play-disc" aria-hidden="true">
              <svg width="23" height="23" viewBox="0 0 24 24" fill="currentColor"><path d="m8 5 11 7-11 7V5Z"></path></svg>
            </span>
            <span class="film-label">{copy.videoPlay}</span>
          </button>
        </div>
        <p class="video-status" role="status" hidden></p>
      </div>
    </section>
  </section>

  <script>
    const button = document.querySelector<HTMLButtonElement>(".audio-button");
    const status = document.querySelector<HTMLParagraphElement>(".pronunciation-status");

    if (button && status && "speechSynthesis" in window && "SpeechSynthesisUtterance" in window) {
      const synthesis = window.speechSynthesis;
      const chooseKoreanVoice = () => {
        const voices = synthesis.getVoices();
        return (
          voices.find((voice) => /^ko[-_]kr$/i.test(voice.lang)) ||
          voices.find((voice) => /^ko(?:[-_]|$)/i.test(voice.lang))
        );
      };

      const showStatus = (message: string) => {
        status.textContent = message;
        status.hidden = !message;
      };

      const updateAvailability = () => {
        const available = Boolean(chooseKoreanVoice());
        button.hidden = !available;
        showStatus(available ? "" : status.dataset.unavailable || "");
      };

      updateAvailability();
      synthesis.addEventListener("voiceschanged", updateAvailability);

      button.addEventListener("click", () => {
        const voice = chooseKoreanVoice();
        if (!voice) {
          updateAvailability();
          return;
        }

        synthesis.cancel();
        showStatus("");
        const utterance = new SpeechSynthesisUtterance("레나 슬기 장");
        utterance.lang = "ko-KR";
        utterance.voice = voice;
        utterance.rate = 0.85;
        utterance.pitch = 1;
        utterance.volume = 1;

        utterance.addEventListener("error", (event) => {
          if (event.error !== "canceled" && event.error !== "interrupted") {
            showStatus(status.dataset.error || "");
          }
        });

        try {
          synthesis.speak(utterance);
        } catch {
          showStatus(status.dataset.error || "");
        }
      });
    }

    const videoSurface = document.querySelector<HTMLElement>("[data-biography-video]");
    const loadVideo = videoSurface?.querySelector<HTMLButtonElement>("[data-load-biography-video]");
    const videoStatus = videoSurface?.querySelector<HTMLParagraphElement>(".video-status");

    if (videoSurface && loadVideo && videoStatus) {
      loadVideo.addEventListener("click", () => {
        const frame = document.createElement("iframe");
        frame.src = "https://www.youtube-nocookie.com/embed/WYXIK4-Rm4c?rel=0&playsinline=1";
        frame.title = videoSurface.dataset.videoTitle || "";
        frame.allow = "encrypted-media; picture-in-picture; fullscreen";
        frame.allowFullscreen = true;
        frame.referrerPolicy = "strict-origin-when-cross-origin";
        frame.tabIndex = 0;
        videoStatus.textContent = videoSurface.dataset.videoLoading || "";
        videoStatus.hidden = false;
        videoSurface.setAttribute("aria-busy", "true");
        frame.addEventListener("load", () => {
          videoSurface.removeAttribute("aria-busy");
          videoStatus.textContent = "";
          videoStatus.hidden = true;
        }, { once: true });
        loadVideo.replaceWith(frame);
        frame.focus();
      }, { once: true });
    }
  </script>

  <style>
    .biography-page {
      padding-block: clamp(56px, 7vw, 108px) clamp(80px, 10vw, 144px);
    }

    .biography-heading {
      margin-bottom: clamp(48px, 6vw, 88px);
    }

    .eyebrow,
    .name-label {
      margin: 0;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.13em;
      line-height: 1.6;
      color: var(--color-accent);
      text-transform: uppercase;
    }

    .artist-heading {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 16px 36px;
      margin-top: 24px;
    }

    .artist-heading h1 {
      max-width: 13ch;
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(58px, 8.7vw, 120px);
      font-weight: 400;
      line-height: 0.98;
      letter-spacing: -0.045em;
      color: var(--color-text);
      overflow-wrap: normal;
    }

    .voice-label {
      font-family: var(--font-display);
      font-size: clamp(25px, 3vw, 38px);
      font-style: italic;
      line-height: 1.3;
      color: var(--color-accent);
    }

    .name-details {
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid var(--color-rule);
    }

    .name-label {
      font-size: 13px;
      color: var(--color-muted);
      letter-spacing: 0.08em;
    }

    .pronunciation-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px 20px;
      margin-top: 10px;
    }

    .bio-pronunciation,
    .bio-guide {
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.7;
      color: var(--color-muted);
    }

    .bio-pronunciation {
      color: var(--color-text);
    }

    .audio-button {
      display: inline-grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid var(--color-rule);
      border-radius: 50%;
      background: transparent;
      color: var(--color-accent);
      cursor: pointer;
      transition: border-color 180ms ease, background-color 180ms ease;
    }

    .audio-button[hidden] {
      display: none;
    }

    .audio-button svg {
      width: 18px;
      height: 18px;
    }

    .audio-button:hover {
      border-color: var(--color-accent);
      background: var(--color-surface);
    }

    .pronunciation-status {
      max-width: 620px;
      margin: 12px 0 0;
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.7;
      color: var(--color-muted);
    }

    .biography-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
      align-items: start;
      gap: clamp(40px, 6.5vw, 88px);
    }

    .bio-portrait {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 120px;
      margin: 0;
    }

    .bio-portrait-image {
      display: block;
      width: 100%;
      height: auto;
      filter: grayscale(100%);
    }

    .bio-portrait figcaption {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px 20px;
      padding-top: 18px;
      font-family: var(--font-body);
      font-size: 14px;
      line-height: 1.6;
      color: var(--color-muted);
    }

    .bio-prose {
      grid-column: 1;
      grid-row: 1;
      min-width: 0;
    }

    .bio-prose p {
      margin: 0 0 28px;
      font-family: var(--font-body);
      font-size: 17px;
      line-height: 1.95;
      color: var(--color-text);
      overflow-wrap: anywhere;
    }

    .bio-prose p:first-child {
      font-family: var(--font-display);
      font-size: clamp(24px, 2.25vw, 31px);
      line-height: 1.55;
      letter-spacing: -0.01em;
      margin-bottom: 36px;
    }

    .bio-prose p:last-child {
      margin-bottom: 0;
    }

    .biography-performance {
      display: grid;
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      align-items: center;
      gap: clamp(40px, 6vw, 80px);
      margin-top: clamp(72px, 10vw, 132px);
      padding-top: clamp(40px, 6vw, 72px);
      border-top: 1px solid var(--color-rule);
    }

    .performance-copy h2 {
      margin: 18px 0 20px;
      font-family: var(--font-display);
      font-size: clamp(42px, 4.2vw, 64px);
      font-weight: 400;
      line-height: 1.05;
      letter-spacing: -0.03em;
      color: var(--color-text);
    }

    .performance-copy > p:not(.eyebrow) {
      max-width: 34ch;
      margin: 0 0 18px;
      font-family: var(--font-body);
      font-size: 17px;
      line-height: 1.8;
      color: var(--color-muted);
    }

    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      min-height: 44px;
      padding-block: 8px;
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.65;
      color: var(--color-accent);
      text-decoration: underline;
      text-underline-offset: 5px;
      text-decoration-thickness: 1px;
    }

    .text-link > span:last-child {
      flex-shrink: 0;
    }

    .performance-media {
      min-width: 0;
    }

    .film-stage {
      aspect-ratio: 16 / 9;
      background: var(--color-surface);
      border: 1px solid var(--color-rule);
    }

    .film-poster {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 18px;
      isolation: isolate;
      width: 100%;
      height: 100%;
      padding: 24px;
      overflow: hidden;
      border: 0;
      background: var(--color-surface);
      color: var(--color-accent);
      cursor: pointer;
    }

    .film-ornament {
      position: absolute;
      z-index: -1;
      right: 4%;
      bottom: -22%;
      font-family: var(--font-display);
      font-size: clamp(190px, 27vw, 440px);
      font-weight: 400;
      line-height: 1;
      color: var(--color-accent);
      opacity: 0.09;
      pointer-events: none;
    }

    .play-disc {
      display: grid;
      place-items: center;
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: var(--color-accent);
      color: var(--color-bg);
      transition: transform 180ms ease;
    }

    .film-poster:hover .play-disc {
      transform: scale(1.05);
    }

    .film-label {
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.6;
    }

    .film-stage :global(iframe) {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .video-status {
      margin: 12px 0 0;
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.6;
      color: var(--color-muted);
    }

    :global(html[lang="ko"]) .biography-page {
      word-break: keep-all;
    }

    @media (max-width: 899px) {
      .biography-page {
        padding-top: 48px;
      }

      .biography-layout,
      .biography-performance {
        grid-template-columns: minmax(0, 1fr);
        gap: 36px;
      }

      .bio-portrait {
        grid-column: 1;
        grid-row: 1;
        position: static;
        width: min(520px, 100%);
        margin-inline: auto;
      }

      .bio-prose {
        grid-column: 1;
        grid-row: 2;
      }

      .biography-performance {
        gap: 28px;
      }

      .performance-copy > p:not(.eyebrow) {
        max-width: 48ch;
      }
    }

    @media (max-width: 480px) {
      .artist-heading h1 {
        font-size: 58px;
      }

      .artist-heading {
        gap: 16px;
      }

      .voice-label {
        font-size: 27px;
      }

      .name-details {
        margin-top: 28px;
      }

      .pronunciation-row {
        gap: 8px 16px;
      }

      .bio-prose p {
        font-size: 16px;
        line-height: 1.95;
      }

      .bio-prose p:first-child {
        font-size: 24px;
        line-height: 1.6;
      }

      .bio-portrait figcaption {
        font-size: 13px;
      }

      .text-link,
      .film-label {
        font-size: 14px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .audio-button,
      .play-disc {
        transition: none;
      }

      .film-poster:hover .play-disc {
        transform: none;
      }
    }
  </style>
</BaseLayout>
