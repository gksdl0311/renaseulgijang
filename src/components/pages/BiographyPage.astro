---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCopy, type Language } from "../../i18n";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const text = getCopy(lang).biography;
---

<BaseLayout lang={lang} current="biography" title={`${text.title} | Rena Seulgi Jang`}>
  <section class="bio-video" aria-label={text.videoTitle}>
    <div class="video-frame">
      <iframe
        src="https://www.youtube.com/embed/WYXIK4-Rm4c?autoplay=1&mute=1&loop=1&playlist=WYXIK4-Rm4c&controls=0&modestbranding=1&rel=0&playsinline=1"
        title={text.videoTitle}
        loading="lazy"
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </section>

  <section class="bio">
    <div class="bio-heading-row">
      <h1 class="bio-title">Rena Seulgi Jang</h1>

      <span class="bio-pronunciation" lang="ko">[ɾe.na sɯl.ɡi tɕaŋ]</span>

      <span class="bio-guide" lang={text.guideLanguage}>{text.pronunciationGuide}</span>

      <button
        class="audio-button"
        type="button"
        aria-label={text.pronunciationLabel}
        aria-describedby="pronunciation-status"
        title={text.pronunciationTitle}
        hidden
      >
        <svg
          class="audio-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polygon points="11 5 6 9 3 9 3 15 6 15 11 19 11 5"></polygon>
          <path d="M15 9.5a4 4 0 0 1 0 5"></path>
          <path d="M17.5 7a7.5 7.5 0 0 1 0 10"></path>
        </svg>
      </button>
    </div>

    <p
      id="pronunciation-status"
      class="pronunciation-status"
      role="status"
      data-unavailable={text.pronunciationUnavailable}
      data-error={text.pronunciationError}
    >{text.pronunciationUnavailable}</p>

    {text.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <script>
    const button = document.querySelector<HTMLButtonElement>(".audio-button");
    const status = document.querySelector<HTMLParagraphElement>(".pronunciation-status");

    if (button && status && "speechSynthesis" in window && "SpeechSynthesisUtterance" in window) {
      const synthesis = window.speechSynthesis;
      const chooseKoreanVoice = () => {
        const voices = synthesis.getVoices();
        return (
          voices.find((voice) => /^ko[-_]kr$/i.test(voice.lang)) ||
          voices.find((voice) => /^ko(?:[-_]|$)/i.test(voice.lang))
        );
      };

      const showStatus = (message: string) => {
        status.textContent = message;
        status.hidden = !message;
      };

      const updateAvailability = () => {
        const available = Boolean(chooseKoreanVoice());
        button.hidden = !available;
        showStatus(available ? "" : status.dataset.unavailable || "");
      };

      updateAvailability();
      synthesis.addEventListener("voiceschanged", updateAvailability);

      button.addEventListener("click", () => {
        const voice = chooseKoreanVoice();
        if (!voice) {
          updateAvailability();
          return;
        }

        synthesis.cancel();
        showStatus("");
        const utterance = new SpeechSynthesisUtterance("레나 슬기 장");
        utterance.lang = "ko-KR";
        utterance.voice = voice;
        utterance.rate = 0.85;
        utterance.pitch = 1;
        utterance.volume = 1;

        utterance.addEventListener("error", (event) => {
          if (event.error !== "canceled" && event.error !== "interrupted") {
            showStatus(status.dataset.error || "");
          }
        });

        try {
          synthesis.speak(utterance);
        } catch {
          showStatus(status.dataset.error || "");
        }
      });
    }
  </script>

  <style>
    :global(main) {
      padding-top: 0 !important;
    }

    .bio-video {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-top: 0;
      margin-bottom: 22px;
      line-height: 0;
    }

    .video-frame {
      position: relative;
      width: 100%;
      height: 34vh;
      min-height: 220px;
      max-height: 360px;
      overflow: hidden;
      background: #000;
    }

    .video-frame iframe {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 220%;
      height: 220%;
      transform: translate(-50%, -50%);
      border: 0;
      pointer-events: none;
    }

    .video-frame::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0) 72%,
        rgba(247, 247, 247, 0.96) 100%
      );
      pointer-events: none;
    }

    .bio {
      max-width: 760px;
      margin: 0 auto;
      padding-top: 0;
    }

    .bio-heading-row {
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      margin: 0 0 30px;
    }

    .bio-title {
      margin: 0;
      font-family: "Times New Roman", Times, serif;
      font-size: 32px;
      font-weight: 400;
      color: #111111;
      line-height: 1.2;
    }

    .bio-pronunciation,
    .bio-guide {
      font-family: "Times New Roman", Times, serif;
      font-size: 14px;
      font-weight: 400;
      color: #6a6a6a;
      line-height: 1.2;
      white-space: nowrap;
    }

    .audio-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      padding: 0;
      border: none;
      background: transparent;
      color: #6a6a6a;
      cursor: pointer;
      transition: color 0.2s ease;
    }

    .audio-button[hidden] {
      display: none;
    }

    .audio-button:hover {
      color: #111111;
    }

    .audio-button:focus-visible {
      outline: 2px solid #6a6a6a;
      outline-offset: 2px;
      border-radius: 50%;
    }

    .audio-icon {
      width: 14px;
      height: 14px;
    }

    .bio p {
      margin: 0 0 18px;
      font-family: "Times New Roman", Times, serif;
      font-size: 17px;
      line-height: 1.8;
      color: #2f2f2f;
      overflow-wrap: anywhere;
    }

    .bio .pronunciation-status {
      margin: -18px 0 24px;
      font-size: 14px;
      line-height: 1.6;
      color: #6a6a6a;
      text-align: center;
    }

    :global(html[lang="ko"]) .bio p {
      word-break: keep-all;
    }

    @media (max-width: 700px) {
      .bio-video {
        margin-bottom: 24px;
      }

      .video-frame {
        height: auto;
        min-height: 0;
        max-height: none;
        aspect-ratio: 16 / 9;
      }

      .video-frame iframe {
        width: 100%;
        height: 100%;
      }

      .bio {
        max-width: 100%;
      }

      .bio-heading-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 44px;
        align-items: center;
        gap: 8px 12px;
        margin: 0 auto 24px;
        max-width: 360px;
      }

      .bio-heading-row:has(.audio-button[hidden]) {
        grid-template-columns: minmax(0, 1fr);
      }

      .bio-title {
        grid-column: 1 / -1;
        text-align: center;
        font-size: 28px;
        margin-bottom: 4px;
      }

      .bio-pronunciation,
      .bio-guide {
        grid-column: 1;
        justify-self: center;
        font-size: 16px;
        line-height: 1.5;
        white-space: normal;
        text-align: center;
      }

      .audio-button {
        grid-column: 2;
        grid-row: 2 / 4;
        width: 44px;
        height: 44px;
      }

      .audio-icon {
        width: 18px;
        height: 18px;
      }

      .bio p {
        font-size: 17px;
        line-height: 1.8;
      }

      .bio .pronunciation-status {
        font-size: 16px;
      }
    }
  </style>
</BaseLayout>
