---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Language } from "../../i18n";
import { sitePath } from "../../site-paths";

interface Props { lang: Language }
const { lang } = Astro.props;
const copy = {
  en: { title: "Photo", portrait: "Portrait", portraitText: "Studio and editorial imagery", portraitAlt: "Portrait gallery", onstage: "Onstage", onstageText: "Performance and production photography", onstageAlt: "Onstage gallery" },
  de: { title: "Fotos", portrait: "Porträt", portraitText: "Studio- und Editorialfotografie", portraitAlt: "Zur Porträtgalerie", onstage: "Auf der Bühne", onstageText: "Fotos von Aufführungen und Inszenierungen", onstageAlt: "Zur Galerie mit Bühnenfotos" },
  ko: { title: "사진", portrait: "프로필", portraitText: "스튜디오 및 화보 사진", portraitAlt: "프로필 사진 갤러리", onstage: "무대", onstageText: "공연 및 오페라 무대 사진", onstageAlt: "무대 사진 갤러리" },
}[lang];
---

<BaseLayout lang={lang} title={`${copy.title} | Rena Seulgi Jang`}>
  <section class="photo-page" aria-label={copy.title}>
    <div class="photo-grid">
      <a class="portrait-card reveal-card reveal-left" href={sitePath(`${lang}/media/photo/portrait/`)} aria-labelledby="portrait-heading">
        <div class="photo-image-wrap portrait-image-wrap">
          <img src={sitePath("media/photo/portrait-cover.jpg")} alt={copy.portraitAlt} class="photo-image" width="1066" height="1600" decoding="async" />
          <div class="photo-overlay"></div>
        </div>
      </a>

      <div class="portrait-copy reveal-text reveal-text-left">
        <h2 id="portrait-heading">{copy.portrait}</h2>
        <p>{copy.portraitText}</p>
      </div>

      <a class="onstage-card reveal-card reveal-right" href={sitePath(`${lang}/media/photo/onstage/`)} aria-labelledby="onstage-heading">
        <div class="photo-image-wrap onstage-image-wrap">
          <img src={sitePath("media/photo/onstage-cover.jpg")} alt={copy.onstageAlt} class="photo-image" width="716" height="888" decoding="async" />
          <div class="photo-overlay"></div>
        </div>
      </a>

      <div class="onstage-copy reveal-text reveal-text-right">
        <h2 id="onstage-heading">{copy.onstage}</h2>
        <p>{copy.onstageText}</p>
      </div>
    </div>
  </section>

  <style>
    .photo-page { max-width: 1100px; margin: 0 auto; padding: 40px 0 80px; }
    .photo-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: "portrait-image onstage-copy" "portrait-copy onstage-image";
      row-gap: 8px;
      column-gap: 48px;
      align-items: start;
    }
    .portrait-card { grid-area: portrait-image; }
    .onstage-copy { grid-area: onstage-copy; margin: 0; }
    .portrait-copy { grid-area: portrait-copy; padding-top: 14px; border-top: 1px solid #d9d9d9; }
    .onstage-card { grid-area: onstage-image; padding-top: 14px; border-top: 1px solid #d9d9d9; transform: translateY(-450px); }
    .portrait-card, .onstage-card { display: block; text-decoration: none; color: inherit; }
    .portrait-card:focus-visible, .onstage-card:focus-visible { outline: 2px solid #111; outline-offset: 5px; }
    .photo-image-wrap { position: relative; overflow: hidden; background: #f3f3f3; height: 520px; }
    .photo-image { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease, filter 0.3s ease; }
    .photo-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.14) 0%, rgba(0, 0, 0, 0.04) 32%, rgba(0, 0, 0, 0.02) 100%);
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    .portrait-copy h2, .onstage-copy h2 {
      margin: 0 0 6px;
      font-family: "Times New Roman", Times, serif;
      font-size: 28px;
      font-weight: 400;
      line-height: 1.2;
      color: #111;
    }
    .portrait-copy p, .onstage-copy p { margin: 0; font-family: "Times New Roman", Times, serif; font-size: 15px; line-height: 1.5; color: #6a6a6a; }
    .reveal-card { opacity: 0; animation-duration: 1s; animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); animation-fill-mode: forwards; }
    .reveal-left { animation-name: portraitReveal; animation-delay: 0.08s; }
    .reveal-right { animation-name: onstageReveal; animation-delay: 0.22s; }
    .reveal-text { opacity: 0; transform: translateY(22px); animation: textReveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
    .reveal-text-left { animation-delay: 0.18s; }
    .reveal-text-right { animation-delay: 0.32s; }
    @keyframes portraitReveal { from { opacity: 0; transform: translateY(36px) scale(0.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @keyframes onstageReveal { from { opacity: 0; transform: translateY(-410px) scale(0.985); } to { opacity: 1; transform: translateY(-450px) scale(1); } }
    @keyframes textReveal { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }

    @media (hover: hover) and (pointer: fine) {
      .portrait-card:hover .photo-image, .onstage-card:hover .photo-image { transform: scale(1.03); filter: brightness(0.98); }
      .portrait-card:hover .photo-overlay, .onstage-card:hover .photo-overlay { opacity: 0.75; }
    }
    @media (max-width: 900px) {
      .photo-grid {
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas: "portrait-image" "portrait-copy" "onstage-image" "onstage-copy";
        row-gap: 16px;
        column-gap: 0;
      }
      .photo-image-wrap { height: auto; }
      .photo-image { height: auto; object-fit: contain; }
      .onstage-card { padding-top: 0; border-top: none; margin-top: 20px; transform: none; animation-name: portraitReveal; }
      .portrait-copy, .onstage-copy { padding-top: 12px; border-top: 1px solid #d9d9d9; }
      .portrait-copy h2, .onstage-copy h2 { font-size: 26px; }
      .portrait-copy p, .onstage-copy p { font-size: 16px; line-height: 1.6; }
    }
    @media (max-width: 640px) { .photo-page { padding: 28px 0 56px; } }
    @media (prefers-reduced-motion: reduce) {
      .reveal-card, .reveal-text { opacity: 1; transform: none; animation: none; }
      .photo-image, .photo-overlay { transition: none; }
      .onstage-card { transform: translateY(-450px); }
    }
    @media (max-width: 900px) and (prefers-reduced-motion: reduce) { .onstage-card { transform: none; } }
  </style>
</BaseLayout>
