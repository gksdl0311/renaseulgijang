---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResponsiveImage from "../ResponsiveImage.astro";
import { getCopy, type Language } from "../../i18n";
import { localizedPath } from "../../i18n/routes";
interface Props { lang: Language }
const { lang } = Astro.props;
const content = getCopy(lang);
const copy = content.photo;
const editorial = content.editorial.gallery;
---
<BaseLayout lang={lang}>
  <section class="gallery-page shell" aria-labelledby="gallery-title">
    <header class="gallery-heading"><p class="eyebrow">{content.home.name}</p><h1 id="gallery-title">{editorial.title}<span aria-hidden="true">.</span></h1><p class="gallery-intro">{editorial.intro}</p></header>
    <div class="gallery-editorial">
      <article class="portrait-collection"><a class="collection-cover" href={localizedPath(lang, "media/photo/portrait")} aria-label={copy.portrait}><ResponsiveImage src="media/photo/portrait-cover.jpg" alt={copy.portraitAlt} sizes="(max-width: 700px) calc(100vw - 40px), 48vw" loading="eager" /></a><div class="collection-copy"><span class="collection-number" aria-hidden="true">01</span><div><h2>{copy.portrait}</h2><p>{copy.portraitText}</p><a class="text-link" href={localizedPath(lang, "media/photo/portrait")}>{editorial.viewCollection}<span class="arrow" aria-hidden="true">↗</span></a></div></div></article>
      <article class="stage-collection"><a class="collection-cover" href={localizedPath(lang, "media/photo/onstage")} aria-label={copy.onstage}><ResponsiveImage src="media/photo/onstage/onstage-01.JPG" alt={copy.onstageAlt} sizes="(max-width: 700px) calc(100vw - 40px), 40vw" /></a><div class="collection-copy"><span class="collection-number" aria-hidden="true">02</span><div><h2>{copy.onstage}</h2><p>{copy.onstageText}</p><a class="text-link" href={localizedPath(lang, "media/photo/onstage")}>{editorial.viewCollection}<span class="arrow" aria-hidden="true">↗</span></a></div></div><figure class="stage-detail"><ResponsiveImage src="media/photo/onstage-cover.jpg" alt={content.repertoire.photoAlt} sizes="(max-width: 700px) 45vw, 22vw" /></figure></article>
    </div>
  </section>
</BaseLayout>
<style>
  .gallery-page { padding-block: clamp(45px, 6vw, 85px) clamp(65px, 8vw, 110px); }
  .gallery-heading { margin-bottom: 60px; }
  .gallery-heading .eyebrow { margin: 0 0 22px; }
  h1 { margin: 0 0 25px; font-size: clamp(64px, 8vw, 112px); font-weight: 400; letter-spacing: -.045em; }
  h1 span { color: var(--color-accent); }
  .gallery-intro { color: var(--color-muted); margin: 0; font-size: 18px; }
  .gallery-editorial { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 8%; align-items: start; }
  .stage-collection { padding-top: 105px; }
  .collection-cover { display: block; }
  .collection-cover :global(img) { width: 100%; height: auto; }
  .collection-copy { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 18px; padding-top: 22px; border-top: 1px solid var(--color-rule); margin-top: 22px; }
  .collection-number { font-size: 12px; color: var(--color-accent); padding-top: 8px; }
  h2 { font-size: 46px; margin: 0 0 10px; }
  .collection-copy p { margin: 0 0 18px; color: var(--color-muted); font-size: 15px; }
  .stage-detail { width: 60%; margin: 50px 0 0 auto; }
  .stage-detail :global(img) { width: 100%; height: auto; }
  @media (max-width: 700px) { .gallery-heading { margin-bottom: 35px; } h1 { font-size: 68px; } .gallery-editorial { grid-template-columns: 1fr; gap: 50px; } .stage-collection { padding-top: 0; } h2 { font-size: 42px; } .stage-detail { width: 50%; margin-top: 30px; } }
  :global(html[lang="ko"]) h1 { font-size: clamp(50px, 6vw, 90px); line-height: 1.3; }
  :global(html[lang="ko"]) h2 { font-size: 35px; }
</style>
