---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResponsiveImage from "../ResponsiveImage.astro";
import { getCopy, formatCopy, type Language } from "../../i18n";
import { artist } from "../../data/artist";
import { sitePath } from "../../site-paths";
import catalogue from "../../data/videos.json";
import descriptions from "../../data/video-descriptions.json";
import manifest from "../../data/image-manifest.json";
import { recordings } from "../../data/recordings";
interface Props { lang: Language }
const { lang } = Astro.props;
const content = getCopy(lang);
const copy = content.video;
const editorial = content.editorial.listen;
const videos = catalogue.videos.map(video => {
  const info = recordings[video.id];
  if (!info) throw new Error(`Missing musical metadata: ${video.id}`);
  const key = info.image.replace(/^\/+/, "") as keyof typeof manifest;
  const image = manifest[key];
  return { ...video, ...info, work: editorial.workTitles[info.work as keyof typeof editorial.workTitles] ?? info.work, description: descriptions[video.id as keyof typeof descriptions][lang],
    categoryLabel: editorial[info.category], image: sitePath(key), width: image.width, height: image.height,
    srcset: image.variants.map(variant => `${sitePath(variant.src)} ${variant.width}w`).join(", "),
    playLabel: formatCopy(copy.play, { title: video.title }), };
});
const first = videos[0];
---
<BaseLayout lang={lang}>
  <section class="listen-page shell" aria-labelledby="listen-title">
    <header class="listen-heading"><div><p class="eyebrow">{content.home.name}</p><h1 id="listen-title">{editorial.title}<span aria-hidden="true">.</span></h1></div><p>{editorial.intro}</p></header>
    <section class="listen-feature" aria-labelledby="recording-title">
      <div class="recording-anchors" aria-hidden="true">{videos.map(video => <span id={`recording-${video.id}`}></span>)}</div>
      <figure class="recording-art"><ResponsiveImage src={recordings[first.id].image} alt={content.home.portrait} sizes="(max-width: 700px) calc(100vw - 40px), 40vw" loading="eager" /><figcaption>{editorial.portraitNote}</figcaption></figure>
      <div class="recording-detail">
        <p class="eyebrow">{editorial.selected}</p><p class="recording-composer" data-composer>{first.composer}</p>
        <h2 id="recording-title" data-piece tabindex="-1">{first.piece}</h2><p class="recording-work" data-work>{first.work}</p>
        <p class="recording-category" data-category>{first.categoryLabel}</p><p class="featured-description" data-description>{first.description}</p>
        <div class="recording-actions"><button class="play-recording" type="button" aria-label={first.playLabel} aria-haspopup="dialog" aria-controls="recording-dialog"><span class="play-symbol" aria-hidden="true">▶</span>{editorial.play}</button><a class="text-link featured-external" href={`https://www.youtube.com/watch?v=${first.id}`} target="_blank" rel="noopener noreferrer">{editorial.external}<span class="arrow" aria-hidden="true">↗</span></a></div>
        <div class="feature-navigation"><span class="selection-counter" role="status" data-template={copy.counter}>{formatCopy(copy.counter, { index: 1, total: videos.length })}</span><div><button type="button" class="recording-previous" aria-label={copy.previous}>←</button><button type="button" class="recording-next" aria-label={copy.next}>→</button></div></div>
      </div>
    </section>
    <section class="recording-library" aria-labelledby="library-heading"><header class="library-heading"><h2 id="library-heading">{copy.library}</h2><a class="text-link" href={artist.youtube} target="_blank" rel="noopener noreferrer">{copy.channel}<span class="arrow" aria-hidden="true">↗</span></a></header>
      <ol class="library-list">
        {videos.map((video, index) => <li class="library-row">
          <button class:list={["video-choice", index === 0 && "is-selected"]} type="button" data-video-id={video.id} aria-pressed={index === 0 ? "true" : "false"} aria-label={formatCopy(copy.select, { title: video.title })}>
            <span class="choice-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <span class="choice-copy"><span class="choice-composer">{video.composer}<span>{video.categoryLabel}</span></span><span class="video-choice-title">{video.title}</span><span class="video-choice-description">{video.description}</span></span><span class="choice-arrow" aria-hidden="true">↗</span>
          </button>
          <a class="library-external" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer" aria-label={`${formatCopy(copy.play, { title: video.title })} — YouTube`}>YouTube<span aria-hidden="true">↗</span></a>
        </li>)}
      </ol>
    </section>
  </section>
  <dialog class="recording-dialog" id="recording-dialog" aria-labelledby="player-title" data-loading={editorial.loading}>
    <div class="player-toolbar"><h2 id="player-title">{first.piece}</h2><button class="player-close" type="button" aria-label={editorial.close} autofocus>×</button></div><div class="player-stage"></div><p class="player-status" role="status"></p><a class="text-link player-external" href={`https://www.youtube.com/watch?v=${first.id}`} target="_blank" rel="noopener noreferrer">{editorial.external}<span aria-hidden="true">↗</span></a>
  </dialog>
  <script id="recording-data" type="application/json" set:html={JSON.stringify(videos).replace(/</g, "\\u003c")} />
</BaseLayout>
<script>
  import { containDialogFocus } from "../../client/dialog-focus";
  interface Recording { id: string; title: string; composer: string; piece: string; work: string; description: string; categoryLabel: string; image: string; srcset: string; width: number; height: number; playLabel: string }
  const payload = document.getElementById("recording-data");
  const recordings: Recording[] = JSON.parse(payload?.textContent ?? "[]");
  const page = document.querySelector<HTMLElement>(".listen-page");
  const dialog = document.querySelector<HTMLDialogElement>(".recording-dialog");
  if (page && dialog && recordings.length) {
    containDialogFocus(dialog);
    const choices = [...page.querySelectorAll<HTMLButtonElement>(".video-choice")];
    const play = page.querySelector<HTMLButtonElement>(".play-recording")!;
    const stage = dialog.querySelector<HTMLElement>(".player-stage")!;
    const status = dialog.querySelector<HTMLElement>(".player-status")!;
    const artwork = page.querySelector<HTMLImageElement>(".recording-art img")!;
    const source = page.querySelector<HTMLSourceElement>(".recording-art source")!;
    const counter = page.querySelector<HTMLElement>(".selection-counter")!;
    const counterTemplate = counter.dataset.template ?? "";
    let selected = 0;
    const select = (index: number, updateHash = true) => {
      selected = (index + recordings.length) % recordings.length;
      const recording = recordings[selected];
      for (const [key, field] of [["composer", "composer"], ["piece", "piece"], ["work", "work"], ["description", "description"], ["category", "categoryLabel"]] as const) page.querySelector<HTMLElement>(`[data-${key}]`)!.textContent = recording[field];
      source.srcset = recording.srcset;
      artwork.src = recording.image;
      artwork.width = recording.width;
      artwork.height = recording.height;
      play.setAttribute("aria-label", recording.playLabel);
      for (const link of [page.querySelector<HTMLAnchorElement>(".featured-external")!, dialog.querySelector<HTMLAnchorElement>(".player-external")!]) link.href = `https://www.youtube.com/watch?v=${recording.id}`;
      dialog.querySelector("#player-title")!.textContent = recording.piece;
      counter.textContent = counterTemplate.replace("{index}", String(selected + 1)).replace("{total}", String(recordings.length));
      choices.forEach((choice, number) => { choice.classList.toggle("is-selected", number === selected); choice.setAttribute("aria-pressed", String(number === selected)); });
      stage.replaceChildren();
      if (dialog.open) dialog.close();
      if (updateHash) {
        history.replaceState(null, "", `#recording-${recording.id}`);
        window.dispatchEvent(new HashChangeEvent("hashchange"));
      }
    };
    const fromHash = () => {
      const index = recordings.findIndex(recording => `#recording-${recording.id}` === window.location.hash);
      if (index >= 0) select(index, false);
    };
    choices.forEach((choice, index) => choice.addEventListener("click", () => {
      select(index);
      page.querySelector<HTMLElement>("[data-piece]")?.focus({ preventScroll: true });
      page.querySelector(".listen-feature")?.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
    }));
    page.querySelector(".recording-previous")?.addEventListener("click", () => select(selected - 1));
    page.querySelector(".recording-next")?.addEventListener("click", () => select(selected + 1));
    play.addEventListener("click", () => {
      if (typeof dialog.showModal !== "function") { window.open(`https://www.youtube.com/watch?v=${recordings[selected].id}`, "_blank", "noopener"); return; }
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${recordings[selected].id}?rel=0&playsinline=1&autoplay=0`;
      frame.title = recordings[selected].title;
      frame.allow = "encrypted-media; picture-in-picture; fullscreen";
      frame.allowFullscreen = true;
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      status.textContent = dialog.dataset.loading ?? "";
      frame.addEventListener("load", () => { status.textContent = ""; }, { once: true });
      stage.replaceChildren(frame);
      dialog.showModal();
      document.body.style.overflow = "hidden";
    });
    dialog.querySelector(".player-close")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener("close", () => { stage.replaceChildren(); status.textContent = ""; document.body.style.overflow = ""; play.focus({ preventScroll: true }); });
    fromHash();
    window.addEventListener("hashchange", fromHash);
  }
</script>
<style>
  .listen-page { padding-block: clamp(45px, 6vw, 85px) clamp(65px, 8vw, 110px); }
  .listen-heading { display: flex; justify-content: space-between; align-items: end; gap: 50px; margin-bottom: 55px; }
  .listen-heading .eyebrow { margin: 0 0 22px; }
  h1 { margin: 0; font-size: clamp(64px, 8vw, 112px); font-weight: 400; letter-spacing: -.045em; }
  h1 > span { color: var(--color-accent); }
  .listen-heading > p { margin: 0 0 6px; max-width: 360px; color: var(--color-muted); font-size: 17px; }
  .recording-anchors { position: absolute; top: 0; left: 0; width: 1px; height: 1px; }
  .recording-anchors span { position: absolute; scroll-margin-top: calc(var(--header-height, 100px) + 24px); }
  .listen-feature { position: relative; scroll-margin-top: calc(var(--header-height, 100px) + 24px); display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(35px, 6vw, 80px); padding-bottom: 65px; }
  .recording-art { min-width: 0; }
  .recording-art :global(img) { width: 100%; height: auto; }
  .recording-art figcaption { margin-top: 13px; color: var(--color-muted); font-size: 11px; }
  .recording-detail { align-self: center; min-width: 0; }
  .recording-detail > .eyebrow { margin: 0 0 35px; }
  .recording-composer { margin: 0 0 14px; color: var(--color-accent); font-size: 15px; }
  #recording-title { margin: 0 0 22px; font-size: clamp(48px, 4.6vw, 67px); font-weight: 400; letter-spacing: -.025em; }
  .recording-work { margin: 0 0 14px; font-family: var(--font-display); font-size: 25px; line-height: 1.35; }
  .recording-category { margin: 0 0 30px; color: var(--color-muted); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
  .featured-description { margin: 0 0 30px; color: var(--color-muted); font-size: 16px; line-height: 1.85; }
  .recording-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 25px; }
  .play-recording { display: inline-flex; gap: 15px; align-items: center; min-height: 52px; padding: 14px 24px; border: 1px solid var(--color-accent); background: var(--color-accent); color: var(--color-bg); font-size: 14px; cursor: pointer; }
  .play-recording:hover { background: var(--color-text); border-color: var(--color-text); }
  .play-symbol { font-size: 13px; }
  .feature-navigation { display: flex; align-items: center; justify-content: space-between; margin-top: 42px; padding-top: 20px; border-top: 1px solid var(--color-rule); }
  .selection-counter { font-size: 12px; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .feature-navigation > div { display: flex; gap: 10px; }
  .feature-navigation button { width: 46px; min-height: 46px; background: transparent; border: 1px solid var(--color-rule); cursor: pointer; font-size: 22px; }
  .feature-navigation button:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .library-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 30px; padding-block: 35px; border-top: 1px solid var(--color-rule); }
  .library-heading h2 { font-size: 50px; font-weight: 400; margin: 0; }
  .library-list { list-style: none; padding: 0; margin: 0; }
  .library-row { position: relative; border-top: 1px solid var(--color-rule); padding: 0 0 20px; }
  .video-choice { display: grid; grid-template-columns: 50px minmax(0, 1fr) 26px; gap: 20px; padding: 30px 14px 16px 0; width: 100%; min-height: 44px; text-align: left; background: transparent; border: 0; cursor: pointer; }
  .choice-number { color: var(--color-muted); font-size: 12px; padding-top: 3px; }
  .choice-composer { display: flex; flex-wrap: wrap; gap: 10px 22px; align-items: center; font-size: 12px; color: var(--color-accent); margin-bottom: 12px; }
  .choice-composer > span { color: var(--color-muted); font-size: 11px; }
  .video-choice-title { display: block; font-family: var(--font-display); font-size: 31px; line-height: 1.3; }
  .video-choice-description { display: block; color: var(--color-muted); font-size: 14px; line-height: 1.8; max-width: 870px; margin-top: 14px; }
  .choice-arrow { color: var(--color-accent); font-size: 23px; }
  .is-selected { background: var(--color-surface); padding-left: 16px; border-left: 2px solid var(--color-accent); }
  .video-choice:hover .video-choice-title { color: var(--color-accent); }
  .library-external { display: inline-flex; align-items: center; gap: 13px; min-height: 44px; margin-left: 70px; font-size: 12px; color: var(--color-accent); }
  .recording-dialog { width: min(1100px, calc(100% - 40px)); max-height: calc(100dvh - 40px); padding: 24px; border: 0; background: var(--color-text); color: var(--color-bg); }
  .recording-dialog::backdrop { background: rgb(0 0 0 / .8); }
  .recording-dialog :focus-visible { outline-color: var(--color-bg); }
  .player-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 20px; }
  .player-toolbar h2 { margin: 0; font-size: 29px; line-height: 1.2; }
  .player-close { min-width: 46px; min-height: 46px; border: 1px solid #817970; color: var(--color-bg); background: transparent; font-size: 25px; cursor: pointer; }
  .player-stage { aspect-ratio: 16 / 9; background: #000; }
  .player-stage :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .player-status { font-size: 13px; }
  .player-external { color: var(--color-bg); font-size: 13px; }
  .player-external:hover { color: #d3b8bd; }
  @media (max-width: 700px) { .listen-heading { display: block; margin-bottom: 35px; } h1 { font-size: 66px; } .listen-heading > p { margin-top: 22px; max-width: none; font-size: 16px; } .listen-feature { grid-template-columns: 1fr; gap: 35px; padding-bottom: 45px; } .recording-detail { grid-row: 1; } .recording-art { width: 75%; margin-left: auto; } .recording-detail > .eyebrow { margin-bottom: 22px; } #recording-title { font-size: 47px; } .feature-navigation { margin-top: 30px; } .library-heading { display: block; padding-block: 25px; } .library-heading h2 { font-size: 42px; margin-bottom: 15px; } .video-choice { grid-template-columns: 25px minmax(0, 1fr) 18px; gap: 12px; padding-right: 0; } .video-choice-title { font-size: 26px; } .video-choice-description { font-size: 15px; } .library-external { margin-left: 37px; font-size: 14px; } .is-selected { padding-left: 10px; } .recording-dialog { width: calc(100% - 20px); padding: 16px; } .player-toolbar h2 { font-size: 23px; } }
  :global(html[lang="ko"]) h1 { font-size: clamp(48px, 6vw, 86px); line-height: 1.3; }
</style>
