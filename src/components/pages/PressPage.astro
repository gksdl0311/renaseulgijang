---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCopy, localeConfig, type Language } from "../../i18n";
import press from "../../data/press.json";
import ResponsiveImage from "../ResponsiveImage.astro";

interface Props {
  lang?: Language;
}

interface PressArticle {
  id: string;
  originalLanguage: string;
  url: string;
  published: string | null;
  originalTitle: string | null;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const { lang = "en" } = Astro.props;
const articles: PressArticle[] = press;
const copy = getCopy(lang).press;
const editorial = getCopy(lang).editorial.press;
const formatDate = (date: string) =>
  new Intl.DateTimeFormat(localeConfig[lang].dateLocale, {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}T12:00:00Z`));
---

<BaseLayout lang={lang} title={`${copy.title} | Rena Seulgi Jang`} description={copy.description}>
  <section class="press-page shell" aria-labelledby="press-title">
    <header class="press-lead">
      <div class="press-introduction">
        <p class="eyebrow">{editorial.eyebrow}</p>
        <h1 id="press-title">{copy.title}<span aria-hidden="true">.</span></h1>
        <p class="press-intro">{copy.intro}</p>
      </div>
      <div class="press-index" aria-hidden="true">
        <span class="press-count">{String(articles.length).padStart(2, "0")}</span>
        <span class="count-label">{editorial.contextLabel}</span>
      </div>
    </header>

    <section class="press-selection" aria-labelledby="selection-title">
      <header class="selection-heading">
        <h2 id="selection-title">{copy.selection}</h2>
        <span class="selection-rule" aria-hidden="true"></span>
      </header>

      <div class="press-grid">
        {articles.map((article, index) => (
          <article class="press-article">
            <a
              class="article-link"
              href={article.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-labelledby={`article-title-${index} article-read-${index}`}
              aria-describedby={`article-summary-${index}`}
            >
              {article.image && (
                <div class="article-thumbnail">
                  <ResponsiveImage
                    src={article.image.replace(/^\/+/, "")}
                    alt={copy.articles[article.id].imageAlt}
                    sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1280px) calc((100vw - 112px) / 2), 576px"
                    loading="lazy"
                    class="press-image"
                  />
                </div>
              )}

              <div class="article-meta">
                <span class="publisher">{copy.articles[article.id].publisher}</span>
                {article.published && <time datetime={article.published}>{formatDate(article.published)}</time>}
              </div>

              <div class="article-copy">
                <h3 id={`article-title-${index}`}>{copy.articles[article.id].title}</h3>
                {lang !== article.originalLanguage && article.originalTitle && (
                  <p class="original-title">
                    <span class="visually-hidden">{copy.originalTitle}: </span>
                    <span lang={article.originalLanguage}>{article.originalTitle}</span>
                  </p>
                )}
                <p class="article-summary" id={`article-summary-${index}`}>{copy.articles[article.id].summary}</p>
              </div>

              <div class="article-action">
                <span id={`article-read-${index}`}>{copy.read}<span class="visually-hidden"> ({copy.newTab})</span></span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </div>
            </a>
          </article>
        ))}
      </div>
      <p class="press-note">{copy.note}</p>
    </section>
  </section>

  <style>
    .press-page { padding-block: clamp(42px, 6vw, 88px) clamp(64px, 8vw, 112px); }
    .press-lead { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 56px; align-items: center; padding-bottom: clamp(44px, 6vw, 76px); }
    .press-introduction { min-width: 0; }
    .eyebrow { margin: 0 0 22px; font-family: var(--font-body); color: var(--color-accent); font-size: 13px; font-weight: 500; letter-spacing: .15em; line-height: 1.6; text-transform: uppercase; }
    .press-lead h1 { margin: 0 0 26px; font-family: var(--font-display); font-size: clamp(60px, 8vw, 112px); font-weight: 400; line-height: .98; letter-spacing: -.04em; }
    .press-lead h1 > span { color: var(--color-accent); }
    .press-intro { max-width: 530px; margin: 0; color: var(--color-muted); font-family: var(--font-body); font-size: 18px; line-height: 1.8; }
    .press-index { display: flex; flex-direction: column; align-items: flex-end; padding-right: 8px; color: var(--color-muted); }
    .press-count { color: var(--color-accent); font-family: var(--font-display); font-size: 112px; font-weight: 400; line-height: .85; letter-spacing: -.045em; }
    .count-label { margin-top: 20px; font-family: var(--font-body); font-size: 12px; line-height: 1.6; letter-spacing: .12em; text-transform: uppercase; }
    .press-selection { border-top: 1px solid var(--color-rule); padding-top: 28px; }
    .selection-heading { display: flex; align-items: center; gap: 28px; margin-bottom: 34px; }
    .selection-heading h2 { margin: 0; color: var(--color-accent); font-family: var(--font-body); font-size: 13px; font-weight: 500; line-height: 1.7; letter-spacing: .1em; text-transform: uppercase; }
    .selection-rule { flex: 1; height: 1px; background: var(--color-rule); }
    .press-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 4vw, 56px); }
    .press-article { min-width: 0; }
    .article-link { display: block; min-height: 44px; color: var(--color-text); }
    .article-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 8px; }
    .article-thumbnail { aspect-ratio: 4 / 3; background: var(--color-surface); }
    .article-thumbnail :global(picture) { width: 100%; height: 100%; display: block; }
    .article-thumbnail :global(img) { width: 100%; height: 100%; display: block; object-fit: contain; }
    .article-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; margin-block: 24px 18px; color: var(--color-muted); font-family: var(--font-body); font-size: 12px; line-height: 1.7; }
    .publisher { color: var(--color-accent); font-weight: 500; letter-spacing: .04em; }
    .article-copy h3 { margin: 0 0 18px; font-family: var(--font-display); font-size: clamp(31px, 2.5vw, 39px); font-weight: 400; line-height: 1.18; letter-spacing: -.012em; transition: color .2s ease; }
    .article-link:hover h3 { color: var(--color-accent); }
    .original-title { margin: 0 0 18px; color: var(--color-muted); font-family: var(--font-body); font-size: 13px; line-height: 1.9; }
    .article-summary { margin: 0; color: var(--color-muted); font-family: var(--font-body); font-size: 15px; line-height: 1.85; }
    .article-action { display: inline-flex; min-height: 44px; align-items: center; justify-content: space-between; gap: 28px; margin-top: 28px; padding-block: 8px; border-bottom: 1px solid var(--color-accent); color: var(--color-accent); font-family: var(--font-body); font-size: 14px; line-height: 1.6; }
    .article-action svg { flex-shrink: 0; transition: transform .2s ease; }
    .article-link:hover .article-action svg { transform: translate(2px, -2px); }
    .press-note { max-width: 620px; margin: 56px 0 0; color: var(--color-muted); font-family: var(--font-body); font-size: 13px; line-height: 1.9; }
    .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    :global(html[lang="ko"]) .press-lead h1 { font-size: clamp(50px, 6vw, 88px); line-height: 1.1; }
    :global(html[lang="ko"]) .article-copy h3 { font-size: clamp(26px, 2.1vw, 32px); line-height: 1.5; letter-spacing: -.025em; }
    @media (max-width: 900px) {
      .press-lead { gap: 32px; }
      .press-count { font-size: 92px; }
      .article-meta { font-size: 13px; }
      .article-summary { font-size: 16px; }
    }
    @media (max-width: 760px) {
      .press-lead { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-bottom: 40px; }
      .press-lead h1 { font-size: clamp(58px, 12vw, 80px); margin-bottom: 20px; }
      .press-intro { font-size: 16px; }
      .press-index { flex-direction: row; align-items: baseline; justify-content: flex-start; gap: 16px; }
      .press-count { font-size: 50px; }
      .count-label { margin: 0; font-size: 13px; }
      .selection-heading h2 { font-size: 14px; }
      .press-grid { grid-template-columns: minmax(0, 1fr); gap: 52px; }
      .article-copy h3 { font-size: 34px; }
      .article-meta { font-size: 14px; }
      .original-title { font-size: 14px; }
      .article-action { font-size: 16px; }
      .press-note { margin-top: 40px; font-size: 14px; }
    }
    @media (prefers-reduced-motion: reduce) { .article-copy h3, .article-action svg { transition: none; } .article-link:hover .article-action svg { transform: none; } }
  </style>
</BaseLayout>
