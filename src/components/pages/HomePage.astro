---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeaturedPerformance from "../FeaturedPerformance.astro";
import ResponsiveImage from "../ResponsiveImage.astro";
import { formatCopy, getCopy, type Language } from "../../i18n";
import { recitalCopy } from "../../i18n/recital";
import { localizedPath } from "../../i18n/routes";
import photoCredits from "../../data/photo-credits.json";

interface Props { lang: Language }
const { lang } = Astro.props;
const content = getCopy(lang);
const recital = recitalCopy[lang];
const editorial = content.editorial.home;
const photographs = [
  { src: "media/photo/onstage/onstage-23.JPG", kind: "onstage", number: 23, placement: "lead-stage", sizes: "(max-width: 700px) calc(100vw - 40px), 56vw" },
  { src: "media/photo/portrait/portrait-01.JPG", kind: "portrait", number: 1, placement: "offset-portrait", sizes: "(max-width: 700px) 70vw, 31vw" },
  { src: "media/photo/onstage/onstage-03.JPG", kind: "onstage", number: 3, placement: "closing-stage", sizes: "(max-width: 700px) 85vw, 46vw" },
] as const;
---

<BaseLayout title={content.home.metaTitle} lang={lang}>
  <section class="hero shell" aria-labelledby="artist-name">
    <div class="hero-copy">
      <p class="hero-edition eyebrow">{recital.edition}</p>
      <h1 id="artist-name" lang="en"><span>Rena</span><span>Seulgi Jang</span></h1>
      <p class="hero-intro">{recital.introduction}</p>
      <a class="hero-listen" href="#listen">{content.editorial.navigation.listen}</a>
    </div>
    <figure class="hero-portrait">
      <ResponsiveImage
        src="hero/portrait.jpg"
        alt={content.home.portrait}
        sizes="(max-width: 700px) min(calc(100vw - 52px), 420px), 420px"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{content.photo.portrait}</figcaption>
    </figure>
  </section>

  <FeaturedPerformance lang={lang} />

  <section class="photography shell" aria-labelledby="photography-heading">
    <p class="programme-kicker eyebrow"><span aria-hidden="true">02</span>{editorial.galleryLabel}</p>
    <h2 id="photography-heading">{editorial.galleryTitle}</h2>

    <div class="photographs">
      {photographs.map(({ src, kind, number, placement, sizes }) => (
        <figure class={placement}>
          <ResponsiveImage src={src} alt={formatCopy(content[kind].alt, { number })} sizes={sizes} />
          <figcaption>
            <span>{content.photo[kind]}</span>
            {src in photoCredits && <span>{formatCopy(content.editorial.gallery.photoCredit, { name: photoCredits[src as keyof typeof photoCredits].photographer })}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="gallery-index">
      <a class="text-link" href={localizedPath(lang, "media/photo")}>{recital.galleryLink}</a>
    </div>
  </section>

  <section class="artist-note shell" aria-labelledby="biography-heading">
    <div>
      <p class="programme-kicker eyebrow"><span aria-hidden="true">03</span>{editorial.introLabel}</p>
      <h2 id="biography-heading">{recital.artistHeading}</h2>
    </div>
    <div class="artist-note-copy">
      <p>{recital.biography}</p>
      <a class="text-link" href={localizedPath(lang, "biography")}>{editorial.biographyLink}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 8vw, 126px);
    padding-block: clamp(46px, 6.1vw, 92px) clamp(52px, 7vw, 106px);
  }
  .hero-copy { padding-block: 14px 27px; }
  .hero-edition { display: flex; align-items: center; gap: 16px; margin: 0 0 clamp(28px, 4vw, 60px); }
  .hero-edition::before { content: ""; width: 40px; height: 1px; background: currentColor; }
  h1 { margin: 0; font-size: clamp(92px, 13vw, 190px); font-weight: 400; letter-spacing: -.068em; line-height: .78; }
  h1 span { display: block; }
  h1 span + span { margin-top: .19em; font-size: .60em; letter-spacing: -.053em; line-height: .98; white-space: nowrap; }
  .hero-intro { margin: clamp(22px, 3vw, 45px) 0 10px; font-size: clamp(15px, 1.55vw, 21px); color: var(--color-muted); }
  .hero-listen { display: inline-flex; align-items: center; min-height: 48px; font-family: var(--font-display); font-size: clamp(26px, 3.2vw, 40px); font-style: italic; line-height: 1.25; border-bottom: 1px solid currentColor; }
  .hero-listen:hover { box-shadow: inset 0 -1px currentColor; }
  .hero-portrait { width: 100%; max-width: 444px; justify-self: end; border-left: 1px solid var(--color-rule); padding-left: clamp(12px, 2vw, 23px); }
  .hero-portrait :global(img) { width: 100%; filter: grayscale(1) contrast(1.06); }
  figcaption { display: flex; justify-content: space-between; gap: 12px; margin-top: 9px; color: var(--color-muted); font-size: 11px; }
  .hero-portrait figcaption { justify-content: end; }

  .photography { padding-block: clamp(60px, 10vw, 144px) clamp(60px, 8vw, 116px); }
  .photography h2, .artist-note h2 { margin: 0; font-size: clamp(48px, 7vw, 100px); font-weight: 400; letter-spacing: -.045em; line-height: .99; }
  .photographs { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(19px, 3vw, 44px); align-items: start; margin-top: clamp(28px, 5vw, 68px); }
  .photographs :global(img) { width: 100%; height: auto; }
  .lead-stage { grid-column: 1 / 9; }
  .offset-portrait { grid-column: 9 / -1; margin-top: clamp(48px, 9vw, 124px); }
  .closing-stage { grid-column: 3 / 10; width: 86%; }
  .gallery-index { display: flex; justify-content: end; margin-top: clamp(15px, 3vw, 32px); }

  .artist-note { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .85fr); gap: clamp(28px, 6vw, 85px); align-items: end; padding-block: clamp(44px, 7vw, 94px) clamp(62px, 9vw, 124px); border-top: 1px solid var(--color-rule); }
  .artist-note h2 { max-width: 9em; }
  .artist-note-copy { max-width: 38em; }
  .artist-note-copy p { margin: 0 0 14px; font-size: clamp(17px, 1.7vw, 22px); }
  :global(html[lang="ko"]) .hero-listen { font-style: normal; font-size: clamp(21px, 2.8vw, 30px); }
  :global(html[lang="ko"]) :is(.photography, .artist-note) h2 { font-size: clamp(35px, 5.1vw, 67px); line-height: 1.23; letter-spacing: -.05em; }
  @media (max-width: 700px) {
    .hero { grid-template-columns: 1fr; gap: 29px; padding-block: 33px 53px; }
    .hero-copy { padding: 0; }
    h1 { font-size: clamp(78px, 23vw, 123px); }
    .hero-intro { margin-bottom: 5px; }
    .hero-portrait { width: min(100%, 444px); }
    .photographs { grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 27px 12px; }
    .lead-stage { grid-column: 1 / -1; }
    .offset-portrait { grid-column: 3 / -1; margin-top: 4px; }
    .closing-stage { grid-column: 1 / 8; width: 100%; }
    .artist-note { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
