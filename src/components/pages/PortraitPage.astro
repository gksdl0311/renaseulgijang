---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCopy, formatCopy, type Language } from "../../i18n";
import { sitePath } from "../../site-paths";

interface Props { lang: Language }
const { lang } = Astro.props;
const copy = getCopy(lang).portrait;
const dimensions = [[2730, 4095], [2667, 4000], [2584, 3877], [1525, 2287], [1280, 1921]];
const images = dimensions.map(([width, height], index) => ({
  name: `portrait-${String(index + 1).padStart(2, "0")}.JPG`, width, height,
}));
---

<BaseLayout lang={lang} title={`${copy.title} | Rena Seulgi Jang`} description={copy.description}>
  <section class="portrait-page" aria-label={copy.gallery}>
    <div class="portrait-masonry">
      {images.map((image, index) => (
        <figure class="portrait-item">
          <img
            src={sitePath(`media/photo/portrait/${image.name}`)}
            alt={formatCopy(copy.alt, { number: index + 1 })}
            width={image.width}
            height={image.height}
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </figure>
      ))}
    </div>
  </section>

  <style>
    .portrait-page { padding: 2rem 0 5rem; max-width: 900px; margin: 0 auto; animation: pageFade 0.7s ease both; }
    .portrait-masonry { column-count: 3; column-gap: 1rem; }
    .portrait-item { margin: 0 0 1rem; break-inside: avoid; opacity: 0; transform: translateY(22px); animation: galleryReveal 0.8s ease forwards; }
    .portrait-item:nth-child(1) { animation-delay: 0.08s; }
    .portrait-item:nth-child(2) { animation-delay: 0.16s; }
    .portrait-item:nth-child(3) { animation-delay: 0.24s; }
    .portrait-item:nth-child(4) { animation-delay: 0.32s; }
    .portrait-item:nth-child(5) { animation-delay: 0.40s; }
    .portrait-item img { display: block; width: 100%; height: auto; object-fit: contain; transition: transform 0.45s ease, filter 0.35s ease; }
    @keyframes galleryReveal { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes pageFade { from { opacity: 0; } to { opacity: 1; } }
    @media (hover: hover) and (pointer: fine) {
      .portrait-item:hover img { transform: translateY(-4px) scale(1.015); filter: brightness(1.02); }
    }
    @media (max-width: 1000px) { .portrait-masonry { column-count: 2; } }
    @media (max-width: 700px) {
      .portrait-page { padding: 1.5rem 0 3rem; }
      .portrait-masonry { column-count: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .portrait-page, .portrait-item { opacity: 1; transform: none; animation: none; }
      .portrait-item img { transition: none; }
    }
  </style>
</BaseLayout>
