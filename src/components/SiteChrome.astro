---
import { getCopy, isLanguage, languages, localeConfig, type Language } from "../i18n";
import { localizedPath, pagePathForRequest } from "../i18n/routes";
import { artist } from "../data/artist";
import { getNavigationLinks } from "../i18n/navigation";
import { sitePath, siteRelativePath } from "../site-paths";

interface Props { lang?: Language }
const { lang = languages[0] } = Astro.props;
const pathLanguage = siteRelativePath(Astro.url.pathname).split("/").filter(Boolean)[0] ?? "";
const currentLang = isLanguage(pathLanguage) ? pathLanguage : lang;
const content = getCopy(currentLang);
const copy = content.navigation;
const editorial = content.editorial.navigation;
const pagePath = pagePathForRequest(Astro.url.pathname);
const links = getNavigationLinks(currentLang);
const isCurrent = (page: string) => pagePath === page;
const isActive = (page: string) => isCurrent(page) || pagePath.startsWith(`${page}/`);
---

<header class="chrome">
  <div class="top">
    <div class="masthead shell">
      <a class="brand-link" href={localizedPath(currentLang)} aria-label={copy.home}>
        <img class="brand-logo" src={sitePath("brand/rena-logo.png")} alt={artist.name} width="618" height="362" />
      </a>

      <nav class="nav" aria-label={copy.primary}>
        {links.map(({ page, label }) => <a class:list={["nav-link", isActive(page) && "is-active"]} href={localizedPath(currentLang, page)} aria-current={isCurrent(page) ? "page" : undefined}>{label}</a>)}
      </nav>

      <div class="lang" role="group" aria-label={copy.languages}>
        {languages.map((code, index) => <>
          {index > 0 && <span class="lang-sep" aria-hidden="true">|</span>}
          <a class:list={["lang-link", currentLang === code && "is-active"]} href={localizedPath(code, pagePath)} hreflang={code} lang={code} aria-label={localeConfig[code].nativeName} aria-current={currentLang === code ? "true" : undefined}>{localeConfig[code].label}</a>
        </>)}
      </div>

      <button class="burger" type="button" aria-label={copy.openMenu} aria-expanded="false" aria-controls="mobile-navigation" data-open-label={copy.openMenu} data-close-label={copy.closeMenu}>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile" id="mobile-navigation" aria-label={copy.mobile} hidden>
    <div class="mobile-inner shell">
      {links.map(({ page, label }, index) => <a class:list={["m-link", isActive(page) && "is-active"]} href={localizedPath(currentLang, page)} aria-current={isCurrent(page) ? "page" : undefined}>
        <span class="m-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <span class="m-label">{label}</span>
        <span class="m-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
  </nav>
</header>

<script>
  const chrome = document.querySelector<HTMLElement>(".chrome");
  const burger = chrome?.querySelector<HTMLButtonElement>(".burger");
  const mobile = chrome?.querySelector<HTMLElement>(".mobile");
  const desktop = window.matchMedia("(min-width: 1101px)");

  function updateLanguageLinks() {
    chrome?.querySelectorAll<HTMLAnchorElement>(".lang-link").forEach((link) => {
      const destination = new URL(link.href);
      destination.search = window.location.search;
      destination.hash = window.location.hash;
      link.href = `${destination.pathname}${destination.search}${destination.hash}`;
    });
  }

  function syncHeaderHeight() {
    const height = chrome?.querySelector<HTMLElement>(".top")?.offsetHeight ?? 100;
    chrome?.style.setProperty("--top-height", `${height}px`);
    document.documentElement.style.setProperty("--header-height", `${height + 1}px`);
  }

  function setMobile(open: boolean, restoreFocus = false) {
    if (!burger || !mobile) return;
    syncHeaderHeight();
    mobile.hidden = !open;
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? burger.dataset.closeLabel! : burger.dataset.openLabel!);
    if (open) {
      mobile.scrollTop = 0;
      mobile.querySelector<HTMLAnchorElement>("a")?.focus({ preventScroll: true });
    } else if (restoreFocus) burger.focus({ preventScroll: true });
  }

  function updateScrolledState() {
    chrome?.classList.toggle("is-scrolled", window.scrollY > 12);
  }

  updateLanguageLinks();
  syncHeaderHeight();
  updateScrolledState();
  window.addEventListener("hashchange", updateLanguageLinks);
  window.addEventListener("popstate", updateLanguageLinks);
  window.addEventListener("scroll", updateScrolledState, { passive: true });
  burger?.addEventListener("click", () => setMobile(burger.getAttribute("aria-expanded") !== "true"));
  chrome?.querySelectorAll<HTMLAnchorElement>("a").forEach(link => link.addEventListener("click", () => setMobile(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && burger?.getAttribute("aria-expanded") === "true") setMobile(false, true);
  });
  document.addEventListener("click", (event) => {
    if (!chrome?.contains(event.target as Node)) setMobile(false);
  });
  chrome?.addEventListener("focusout", (event) => {
    if (!chrome.contains(event.relatedTarget as Node | null)) setMobile(false);
  });
  window.addEventListener("resize", () => {
    syncHeaderHeight();
    if (desktop.matches) setMobile(false);
  });
  new ResizeObserver(syncHeaderHeight).observe(chrome!.querySelector(".top")!);
</script>

<style>
  .site-top-anchor { display: block; height: 0; }
  .chrome {
    position: sticky;
    top: 0;
    z-index: 80;
    background: var(--color-bg, #f7f3ec);
    border-bottom: 1px solid var(--color-rule, #d8d0c7);
    transition: box-shadow 180ms ease;
  }
  .chrome.is-scrolled { box-shadow: 0 4px 20px rgb(36 33 30 / 4%); }
  .masthead { min-height: 88px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: clamp(16px, 1.6vw, 24px); align-items: center; }
  .brand-link { width: 116px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
  .brand-logo { width: 116px; height: auto; display: block; mix-blend-mode: multiply; }
  .nav { display: flex; align-items: center; justify-content: center; gap: clamp(12px, 1.2vw, 19px); min-width: 0; }
  .nav-link { position: relative; display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; color: var(--color-text, #24211e); font-family: var(--font-body, sans-serif); font-size: 14px; font-weight: 450; letter-spacing: .015em; white-space: nowrap; text-decoration: none; transition: color 180ms ease; }
  .nav-link::after { content: ""; position: absolute; left: 0; right: 0; bottom: 6px; height: 1px; background: var(--color-accent, #6b2c3e); transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; }
  .nav-link:hover, .nav-link.is-active { color: var(--color-accent, #6b2c3e); }
  .nav-link:hover::after, .nav-link.is-active::after { transform: scaleX(1); }
  .lang { display: inline-flex; align-items: center; justify-content: center; min-width: 0; }
  .lang-link { position: relative; display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 8px 4px; color: var(--color-muted, #756c63); font-family: var(--font-body, sans-serif); font-size: 12px; line-height: 1.2; font-weight: 450; letter-spacing: .06em; white-space: nowrap; text-decoration: none; transition: color 180ms ease; }
  .lang-link[lang="ko"] { font-size: 13px; letter-spacing: 0; }
  .lang-link::after { content: ""; position: absolute; right: 13px; bottom: 7px; left: 13px; height: 1px; background: currentColor; opacity: 0; transition: opacity 180ms ease; }
  .lang-link:hover, .lang-link.is-active { color: var(--color-accent, #6b2c3e); }
  .lang-link:hover::after, .lang-link.is-active::after { opacity: 1; }
  .lang-sep { color: var(--color-rule, #d8d0c7); font-size: 10px; }
  .burger { display: none; width: 44px; height: 44px; flex-shrink: 0; padding: 0; border: 1px solid var(--color-rule, #d8d0c7); background: transparent; color: var(--color-text, #24211e); cursor: pointer; align-items: center; justify-content: center; flex-direction: column; gap: 6px; transition: border-color 180ms ease; }
  .burger:hover { border-color: var(--color-accent, #6b2c3e); }
  .burger span { display: block; width: 20px; height: 1px; background: currentColor; transition: transform 180ms ease; }
  .burger[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .burger[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .mobile { display: none; border-top: 1px solid var(--color-rule, #d8d0c7); background: var(--color-bg, #f7f3ec); max-height: calc(100vh - var(--top-height, 100px)); max-height: calc(100dvh - var(--top-height, 100px)); overflow-y: auto; overscroll-behavior: contain; }
  .mobile-inner { display: flex; flex-direction: column; padding-block: 12px 24px; }
  .m-link { display: grid; grid-template-columns: 24px minmax(0, 1fr) 22px; align-items: center; gap: 16px; min-height: 66px; padding-block: 14px; border-bottom: 1px solid var(--color-rule, #d8d0c7); color: var(--color-text, #24211e); text-decoration: none; }
  .m-index { font-family: var(--font-body, sans-serif); font-size: 10px; letter-spacing: .04em; color: var(--color-muted, #756c63); }
  .m-label { font-family: var(--font-display, serif); font-size: clamp(27px, 4vw, 35px); font-weight: 500; line-height: 1.15; overflow-wrap: anywhere; }
  .m-arrow { font-size: 20px; color: var(--color-accent, #6b2c3e); transition: transform 180ms ease; }
  .m-link:hover, .m-link.is-active { color: var(--color-accent, #6b2c3e); }
  .m-link:hover .m-arrow { transform: translate(2px, -2px); }
  [hidden] { display: none !important; }
  @media (max-width: 1100px) {
    .masthead { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); min-height: 82px; gap: 16px; }
    .brand-link { justify-self: start; }
    .nav { display: none; }
    .burger { display: inline-flex; justify-self: end; }
    .mobile:not([hidden]) { display: block; }
    .lang-link { font-size: 13px; }
    .lang-link[lang="ko"] { font-size: 14px; }
  }
  @media (max-width: 600px) {
    .masthead { grid-template-columns: minmax(0, 1fr) auto; gap: 0 16px; padding-top: 2px; min-height: 0; }
    .brand-link { grid-column: 1; grid-row: 1; width: 106px; min-height: 64px; }
    .brand-logo { width: 106px; }
    .burger { grid-column: 2; grid-row: 1; }
    .lang { grid-column: 1 / -1; grid-row: 2; width: 100%; padding-block: 1px 4px; border-top: 1px solid var(--color-rule, #d8d0c7); }
    .m-link { min-height: 60px; gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chrome, .nav-link, .nav-link::after, .lang-link, .lang-link::after, .burger, .burger span, .m-arrow { transition: none; }
  }
</style>
