---
const { lang = "en" } = Astro.props;

const instaUrl = "https://www.instagram.com/rrenajang/?hl=en";
const youtubeUrl = "https://www.youtube.com/@SopranoRena";

const path = Astro.url.pathname;

const basePath = (code) => `/${code}/`;
const segments = Astro.url.pathname.split("/").filter(Boolean);
const currentLang = ["en", "de", "ko"].includes(segments[0]) ? segments[0] : lang;
const isLang = (code) => currentLang === code;

const isActive = (href) => {
  if (href === basePath(currentLang)) {
    return path === href;
  }

  return path.startsWith(href);
};
---

<header class="chrome">
  <input id="navToggle" class="nav-toggle" type="checkbox" aria-label="Open menu" />

  <div class="top">
    <div class="top-inner">
      <div class="top-left"></div>

      <div class="brand">
        <a class="brand-link" href={basePath(currentLang)} aria-label="Home">
          <img class="brand-logo" src="/brand/rena-logo.png" alt="Rena Seulgi Jang" />
        </a>
      </div>

      <div class="top-right">
        <a class="icon-link" href={instaUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm10 2H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3zm-5 4.5A5.5 5.5 0 1 1 6.5 14 5.5 5.5 0 0 1 12 8.5zm0 2A3.5 3.5 0 1 0 15.5 14 3.5 3.5 0 0 0 12 10.5zM18 6.8a1.2 1.2 0 1 1-1.2 1.2A1.2 1.2 0 0 1 18 6.8z"/>
          </svg>
        </a>

        <a class="icon-link" href={youtubeUrl} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M21.6 7.2a3 3 0 0 0-2.1-2.1C17.7 4.6 12 4.6 12 4.6s-5.7 0-7.5.5A3 3 0 0 0 2.4 7.2 31.6 31.6 0 0 0 2 12a31.6 31.6 0 0 0 .4 4.8 3 3 0 0 0 2.1 2.1c1.8.5 7.5.5 7.5.5s5.7 0 7.5-.5a3 3 0 0 0 2.1-2.1A31.6 31.6 0 0 0 22 12a31.6 31.6 0 0 0-.4-4.8zM10 15.5v-7l6 3.5-6 3.5z"/>
          </svg>
        </a>

        <div class="lang" aria-label="Language switcher">
          <a class:list={["lang-link", isLang("en") ? "is-active" : ""]} href={basePath("en")}>EN</a>
          <span class="lang-sep">/</span>
          <a class:list={["lang-link", isLang("de") ? "is-active" : ""]} href={basePath("de")}>DE</a>
          <span class="lang-sep">/</span>
          <a class:list={["lang-link", isLang("ko") ? "is-active" : ""]} href={basePath("ko")}>KO</a>
        </div>

        <label for="navToggle" class="burger" aria-label="Menu">
          <span></span><span></span>
        </label>
      </div>
    </div>
  </div>

  <nav class="nav" aria-label="Primary navigation">
    <a class:list={["nav-link", isActive(basePath(currentLang)) ? "is-active" : ""]} href={basePath(currentLang)}>Home</a>
    <a class:list={["nav-link", isActive(`${basePath(currentLang)}biography/`) ? "is-active" : ""]} href={`${basePath(currentLang)}biography/`}>Biography</a>
    <a class:list={["nav-link", isActive(`${basePath(currentLang)}repertoire/`) ? "is-active" : ""]} href={`${basePath(currentLang)}repertoire/`}>Repertoire</a>
    <a class:list={["nav-link", isActive(`${basePath(currentLang)}schedule/`) ? "is-active" : ""]} href={`${basePath(currentLang)}schedule/`}>Schedule</a>

   <div class="drop">
  <span
    class:list={["nav-link", "has-drop", isActive(`${basePath(currentLang)}media/`) ? "is-active" : ""]}
    aria-haspopup="true"
  >
    Media <span class="chev" aria-hidden="true">▾</span>
  </span>

  <div class="menu" role="menu" aria-label="Media submenu">
    <a class="menu-link" href={`${basePath(currentLang)}media/video/`} role="menuitem">Video</a>

    <div class="menu-group">
      <a class="menu-link" href={`${basePath(currentLang)}media/photo/`} role="menuitem">
        Photo <span class="chev right" aria-hidden="true">▸</span>
      </a>

      <div class="menu sub" role="menu" aria-label="Photo submenu">
        <a class="menu-link" href={`${basePath(currentLang)}media/photo/onstage/`} role="menuitem">Onstage</a>
        <a class="menu-link" href={`${basePath(currentLang)}media/photo/portrait/`} role="menuitem">Portrait</a>
      </div>
    </div>
  </div>
</div>

    <a class:list={["nav-link", isActive(`${basePath(currentLang)}contact/`) ? "is-active" : ""]} href={`${basePath(currentLang)}contact/`}>Contact</a>
  </nav>

  <nav class="mobile" aria-label="Mobile navigation">
    <div class="mobile-inner">
      <a class:list={["m-link", isActive(basePath(currentLang)) ? "is-active" : ""]} href={basePath(currentLang)}>Home</a>
      <a class:list={["m-link", isActive(`${basePath(currentLang)}biography/`) ? "is-active" : ""]} href={`${basePath(currentLang)}biography/`}>Biography</a>
      <a class:list={["m-link", isActive(`${basePath(currentLang)}repertoire/`) ? "is-active" : ""]} href={`${basePath(currentLang)}repertoire/`}>Repertoire</a>
      <a class:list={["m-link", isActive(`${basePath(currentLang)}schedule/`) ? "is-active" : ""]} href={`${basePath(currentLang)}schedule/`}>Schedule</a>

      <details class="m-details" open={isActive(`${basePath(currentLang)}media/`)}>
        <summary class="m-summary">Media</summary>
        <div class="m-sub">
          <a class="m-sublink" href={`${basePath(currentLang)}media/video/`}>Video</a>

          <details class="m-details">
            <summary class="m-summary">Photo</summary>
            <div class="m-sub">
              <a class="m-sublink" href={`${basePath(currentLang)}media/photo/onstage/`}>Onstage</a>
              <a class="m-sublink" href={`${basePath(currentLang)}media/photo/portrait/`}>Portrait</a>
            </div>
          </details>

        </div>
      </details>

      <a class:list={["m-link", isActive(`${basePath(currentLang)}contact/`) ? "is-active" : ""]} href={`${basePath(currentLang)}contact/`}>Contact</a>
    </div>
  </nav>

  <style>
    a {
      text-decoration: none;
    }

    :global(:root) {
      --bg: #ffffff;
      --text: #111111;
      --muted: #6f6f6f;
      --rule: #d9d9d9;
      --hover: #111111;
      --max: 1100px;
    }

    .chrome {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
    }

    .top {
      background: var(--bg);
    }
.has-drop {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  cursor: default;
}
    .top-inner {
      max-width: var(--max);
      margin: 0 auto;
      padding: 8px 18px 4px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .top-left {
      justify-self: start;
    }

    .brand {
      justify-self: center;
    }

    .brand-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .brand-logo {
      width: min(180px, 38vw);
      height: auto;
      display: block;
    }

    .top-right {
      justify-self: end;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .icon-link {
      color: var(--muted);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 6px;
      border-radius: 10px;
      transition: color .2s ease, background .2s ease;
    }

    .icon-link:hover {
      color: var(--text);
      background: rgba(0, 0, 0, 0.03);
    }

    .icon-link svg {
      fill: currentColor;
      display: block;
    }

    .lang {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding-left: 10px;
      margin-left: 4px;
      border-left: 1px solid var(--rule);
    }

    .lang-link {
      color: var(--muted);
      font-family: "Times New Roman", Times, serif;
      letter-spacing: .08em;
      font-size: 14px;
      padding: 6px 0;
      position: relative;
      transition: color .2s ease;
      text-decoration: none;
    }

    .lang-link:hover {
      color: var(--hover);
    }

    .lang-link::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 2px;
      height: 1px;
      background: var(--text);
      opacity: 0;
      transition: opacity .2s ease;
    }

    .lang-link:hover::after,
    .lang-link.is-active::after {
      opacity: .65;
    }

    .lang-link.is-active {
      color: var(--text);
    }

    .lang-sep {
      color: rgba(17, 17, 17, 0.35);
      font-size: 12px;
    }

    .nav {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 18px 8px;
      display: flex;
      justify-content: center;
      gap: 22px;
      flex-wrap: wrap;
    }

    .nav-link {
      color: var(--muted);
      font-family: "Times New Roman", Times, serif;
      letter-spacing: .10em;
      font-size: 14px;
      padding: 8px 0;
      position: relative;
      white-space: nowrap;
      transition: color .2s ease;
      text-decoration: none;
    }

    .nav-link:hover {
      color: var(--hover);
    }

    .nav-link::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 2px;
      height: 1px;
      background: var(--text);
      opacity: 0;
      transition: opacity .2s ease;
    }

    .nav-link:hover::after,
    .nav-link.is-active::after {
      opacity: 0.5;
    }

    .nav-link.is-active {
      color: var(--text);
    }

    .drop {
      position: relative;
    }

    .drop::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: 14px;
    }

    .has-drop {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .chev {
      font-size: 11px;
      color: rgba(17, 17, 17, 0.45);
    }

    .chev.right {
      font-size: 12px;
    }

    .menu {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      left: 50%;
      transform: translateX(-50%);
      min-width: 180px;
      background: #ffffff;
      border: 1px solid var(--rule);
      border-radius: 14px;
      padding: 8px;
      box-shadow: 0 14px 40px rgba(0, 0, 0, 0.10);
      z-index: 60;
    }

    .drop:hover > .menu,
    .drop:focus-within > .menu {
      display: block;
    }

    .menu-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 10px;
      border-radius: 10px;
      font-size: 13px;
      color: var(--muted);
      transition: color .2s ease, background .2s ease;
      text-decoration: none;
      white-space: nowrap;
    }

    .menu-link:hover {
      color: var(--text);
      background: rgba(0, 0, 0, 0.03);
    }

    .menu-group {
      position: relative;
    }

    .menu-group::after {
      content: "";
      position: absolute;
      top: 0;
      left: 100%;
      width: 12px;
      height: 100%;
    }

    .menu.sub {
      display: none;
      position: absolute;
      top: 0;
      left: calc(100% + 8px);
      min-width: 180px;
      background: #ffffff;
      border: 1px solid var(--rule);
      border-radius: 14px;
      padding: 8px;
      box-shadow: 0 14px 40px rgba(0, 0, 0, 0.10);
      z-index: 70;
      transform: none;
    }

    .menu-group:hover > .menu.sub,
    .menu-group:focus-within > .menu.sub {
      display: block;
    }

    .nav-toggle {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .burger {
      display: none;
      width: 40px;
      height: 40px;
      border: 1px solid var(--rule);
      border-radius: 12px;
      align-items: center;
      justify-content: center;
      gap: 6px;
      cursor: pointer;
    }

    .burger span {
      width: 16px;
      height: 1px;
      background: rgba(17, 17, 17, 0.85);
      display: block;
    }

    .mobile {
      display: none;
      border-top: 1px solid var(--rule);
      background: var(--bg);
    }

    .mobile-inner {
      max-width: var(--max);
      margin: 0 auto;
      padding: 12px 18px 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .m-link,
    .m-sublink {
      font-variant-caps: small-caps;
      letter-spacing: .14em;
      font-size: 12px;
      color: var(--muted);
      padding: 6px 0;
      width: fit-content;
      transition: color .2s ease;
    }

    .m-link:hover,
    .m-sublink:hover {
      color: var(--text);
    }

    .m-link.is-active {
      color: var(--text);
    }

    .m-details {
      border-left: 1px solid var(--rule);
      padding-left: 10px;
      margin-left: 2px;
    }

    .m-summary {
      list-style: none;
      cursor: pointer;
      font-variant-caps: small-caps;
      letter-spacing: .14em;
      font-size: 12px;
      color: var(--muted);
      padding: 6px 0;
    }

    .m-details summary::-webkit-details-marker {
      display: none;
    }

    .m-sub {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 6px;
    }

    @media (max-width: 900px) {
      .nav {
        display: none;
      }

      .burger {
        display: inline-flex;
      }

      .nav-toggle:checked ~ .mobile {
        display: block;
      }

      .brand-logo {
        width: min(160px, 42vw);
      }
    }

    @media (max-width: 640px) {
      .top-inner {
        grid-template-columns: auto 1fr auto;
        gap: 10px;
      }

      .top-left {
        display: none;
      }

      .brand {
        justify-self: start;
      }

      .top-right {
        gap: 6px;
      }

      .lang {
        padding-left: 8px;
        margin-left: 2px;
      }

      .brand-logo {
        width: min(140px, 40vw);
      }
    }
  </style>
</header>