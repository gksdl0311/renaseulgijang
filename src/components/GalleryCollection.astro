---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "./ResponsiveImage.astro";
import photoCredits from "../data/photo-credits.json";
import { getCopy, formatCopy, type Language } from "../i18n";
import { localizedPath } from "../i18n/routes";
import { sitePath } from "../site-paths";
import { photoCollections, type PhotoCollection } from "../data/photos";
interface Props { lang: Language; kind: PhotoCollection }
const { lang, kind } = Astro.props;
const content = getCopy(lang);
const copy = content.editorial.gallery;
const photos = photoCollections[kind];
const label = content.photo[kind];
const alt = content[kind].alt;
---
<BaseLayout lang={lang}>
  <section class:list={["collection-page shell", kind]} aria-labelledby="collection-title">
    <header class="collection-header">
      <a class="eyebrow collection-back" href={localizedPath(lang, "media/photo")}><span aria-hidden="true">←</span>{copy.title}</a>
      <div class="collection-heading"><h1 id="collection-title">{label}<span aria-hidden="true">.</span></h1><p>{kind === "onstage" ? content.photo.onstageText : content.photo.portraitText}</p></div>
    </header>
    <div class="collection-grid" aria-label={content[kind].gallery}>
      {photos.map((src, index) => <figure class="gallery-item">
        <a class="gallery-open" href={sitePath(src)} target="_blank" rel="noopener noreferrer" data-photo data-index={index} aria-label={formatCopy(copy.open, { number: index + 1 })} aria-haspopup="dialog" aria-controls="photograph-dialog">
          <ResponsiveImage src={src} alt={formatCopy(alt, { number: index + 1 })} sizes={kind === "onstage" ? "(max-width: 600px) calc(100vw - 40px), (max-width: 900px) 44vw, 30vw" : "(max-width: 600px) calc(100vw - 40px), 44vw"} loading={index === 0 ? "eager" : "lazy"} />
          <span class="enlarge-mark" aria-hidden="true">↗</span>
        </a>
        <figcaption><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>{photoCredits[src as keyof typeof photoCredits] && <span class="photographer-credit">{formatCopy(copy.photoCredit, { name: photoCredits[src as keyof typeof photoCredits].photographer })}</span>}</figcaption>
      </figure>)}
    </div>
  </section>
  <dialog id="photograph-dialog" class="photograph-dialog" aria-label={kind === "onstage" ? copy.onstageDialog : copy.portraitDialog} data-counter={copy.counter}>
    <div class="dialog-toolbar"><span class="photo-counter" role="status"></span><a class="photo-original" target="_blank" rel="noopener noreferrer">{copy.original}<span aria-hidden="true">↗</span></a><button class="photo-close" type="button" aria-label={copy.close} autofocus>×</button></div>
    <div class="dialog-image"><img class="full-photograph" alt="" /></div>
    <div class="dialog-navigation"><p class="dialog-credit"></p><button class="photo-previous" type="button" aria-label={copy.previous}>←</button><button class="photo-next" type="button" aria-label={copy.next}>→</button></div>
  </dialog>
</BaseLayout>
<script>
  import { containDialogFocus } from "../client/dialog-focus";
  const dialog = document.querySelector<HTMLDialogElement>(".photograph-dialog");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-photo]")];
  if (dialog && typeof dialog.showModal === "function") {
    containDialogFocus(dialog);
    const image = dialog.querySelector<HTMLImageElement>(".full-photograph")!;
    const counter = dialog.querySelector<HTMLElement>(".photo-counter")!;
    const original = dialog.querySelector<HTMLAnchorElement>(".photo-original")!;
    let selected = 0;
    let opener: HTMLAnchorElement | undefined;
    const select = (index: number) => {
      selected = (index + links.length) % links.length;
      const link = links[selected];
      image.src = link.href;
      image.alt = link.querySelector("img")?.alt ?? "";
      original.href = link.href;
      dialog.querySelector<HTMLElement>(".dialog-credit")!.textContent = link.closest("figure")?.querySelector(".photographer-credit")?.textContent ?? "";
      counter.textContent = (dialog.dataset.counter ?? "").replace("{index}", String(selected + 1)).replace("{total}", String(links.length));
    };
    links.forEach((link, index) => link.addEventListener("click", event => {
      event.preventDefault();
      opener = link;
      select(index);
      dialog.showModal();
      document.body.style.overflow = "hidden";
    }));
    dialog.querySelector(".photo-close")?.addEventListener("click", () => dialog.close());
    dialog.querySelector(".photo-previous")?.addEventListener("click", () => select(selected - 1));
    dialog.querySelector(".photo-next")?.addEventListener("click", () => select(selected + 1));
    dialog.addEventListener("keydown", event => {
      if (event.key === "ArrowLeft") { event.preventDefault(); select(selected - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); select(selected + 1); }
    });
    dialog.addEventListener("click", event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
      image.removeAttribute("src");
      opener?.focus({ preventScroll: true });
    });
  }
</script>
<style>
  .collection-page { padding-block: clamp(45px, 6vw, 85px) clamp(65px, 8vw, 110px); }
  .collection-back { display: inline-flex; align-items: center; gap: 15px; min-height: 44px; margin-bottom: 28px; }
  .collection-heading { display: flex; justify-content: space-between; align-items: end; gap: 45px; padding-bottom: 45px; margin-bottom: 40px; border-bottom: 1px solid var(--color-rule); }
  h1 { margin: 0; font-size: clamp(64px, 8vw, 112px); font-weight: 400; letter-spacing: -.045em; }
  h1 span { color: var(--color-accent); }
  .collection-heading p { max-width: 270px; margin: 0 0 5px; color: var(--color-muted); font-size: 16px; }
  .collection-grid { column-count: 3; column-gap: 28px; }
  .portrait .collection-grid { column-count: 2; column-gap: 50px; }
  .gallery-item { margin: 0 0 28px; break-inside: avoid; }
  .gallery-open { display: block; position: relative; cursor: zoom-in; min-height: 44px; }
  .gallery-open :global(img) { width: 100%; height: auto; }
  .enlarge-mark { position: absolute; right: 12px; bottom: 12px; width: 34px; height: 34px; display: grid; place-items: center; background: var(--color-bg); color: var(--color-accent); font-size: 18px; opacity: 0; transition: opacity .2s ease; }
  .gallery-open:hover .enlarge-mark, .gallery-open:focus-visible .enlarge-mark { opacity: 1; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 15px; margin-top: 10px; color: var(--color-muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .photograph-dialog { position: fixed; inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 20px 30px; border: 0; background: #24211e; color: #f7f3ec; }
  .photograph-dialog[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; gap: 15px; }
  .photograph-dialog::backdrop { background: #24211e; }
  .dialog-toolbar { display: flex; align-items: center; gap: 25px; min-width: 0; }
  .photo-counter { font-size: 13px; flex-shrink: 0; }
  .photo-original { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; margin-left: auto; font-size: 13px; }
  .photo-close, .dialog-navigation button { width: 48px; min-height: 48px; background: transparent; color: #f7f3ec; border: 1px solid #817970; cursor: pointer; font-size: 25px; flex-shrink: 0; }
  .photograph-dialog :focus-visible { outline-color: #f7f3ec; }
  .dialog-image { min-height: 0; display: flex; justify-content: center; align-items: center; }
  .full-photograph { width: 100%; height: 100%; object-fit: contain; }
  .dialog-navigation { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
  .dialog-credit { flex-basis: 100%; text-align: center; margin: 0; font-size: 12px; }
  .dialog-credit:empty { display: none; }
  @media (max-width: 900px) { .collection-grid { column-count: 2; } .portrait .collection-grid { column-gap: 28px; } }
  @media (max-width: 600px) { .collection-heading { display: block; margin-bottom: 30px; padding-bottom: 30px; } h1 { font-size: 66px; } .collection-heading p { margin-top: 20px; max-width: none; } .collection-grid, .portrait .collection-grid { column-count: 1; } .photograph-dialog { padding: 12px 14px; } .dialog-toolbar { gap: 10px; } .photo-original { max-width: 210px; font-size: 12px; } .enlarge-mark { opacity: 1; } }
  :global(html[lang="ko"]) h1 { font-size: clamp(50px, 6vw, 90px); line-height: 1.3; }
</style>
