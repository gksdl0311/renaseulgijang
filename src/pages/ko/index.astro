---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout lang="ko" current="home" title="Rena Seulgi Jang | 소프라노">
  <section class="coming">
    <p class="label">소프라노</p>
    <h1>레나 슬기 장</h1>

    <p class="text">
      한국어 페이지는 현재 준비 중입니다.
      <br />
      당분간은 영어 페이지를 참고해 주세요.
    </p>

    <p class="note"> 양해해주셔서 감사합니다.</p>
  </section>

  <style>
    .coming {
      min-height: 60vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .label {
      text-transform: uppercase;
      letter-spacing: 0.22em;
      font-size: 0.75rem;
      opacity: 0.7;
      margin-bottom: 0.6rem;
    }

    h1 {
      font-size: clamp(2.4rem, 5vw, 3.6rem);
      margin-bottom: 1.2rem;
    }

    .text {
      max-width: 34ch;
      font-size: 1.05rem;
      margin-bottom: 0.8rem;
    }

    .note {
      font-size: 0.9rem;
      opacity: 0.6;
    }
  </style>
</BaseLayout>
