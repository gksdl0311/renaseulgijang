---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const pdfUrl = "/cv/Rena_Seulgi_Jang_CV.pdf";
---

<BaseLayout lang="en" current="cv" title="CV | Rena Seulgi Jang">
  <section class="cv-page">
    <header class="cv-hero">
      <div class="cv-hero-text">
        <h1 class="cv-title">Curriculum Vitae</h1>
        <p class="cv-sub">View the preview below or download the PDF.</p>
      </div>

      <!-- ✨ ICON ACTIONS -->
      <div class="cv-actions">
        <a href={pdfUrl} target="_blank" rel="noopener" class="cv-icon" aria-label="Download CV">
          <svg viewBox="0 0 24 24" class="icon">
            <path d="M12 3v12m0 0l4-4m-4 4l-4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
            <path d="M4 17v2h16v-2" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
          </svg>
        </a>

        <button type="button" id="shareBtn" class="cv-icon" aria-label="Share">
          <svg viewBox="0 0 24 24" class="icon">
            <circle cx="18" cy="5" r="2"></circle>
            <circle cx="6" cy="12" r="2"></circle>
            <circle cx="18" cy="19" r="2"></circle>
            <path d="M8 12l8-6M8 12l8 6" stroke="currentColor" stroke-width="1.4" fill="none"/>
          </svg>
        </button>
      </div>
    </header>

    <section class="cv-preview card">
      <div class="card-head">
        <h2>Preview</h2>
      </div>

      <div class="pdf-frame">
        <iframe
          title="Rena Seulgi Jang CV"
          src={`${pdfUrl}#view=FitH`}
          loading="lazy"
        ></iframe>
      </div>
    </section>

    <section class="cv-sections">
      <details class="card">
        <summary>
          <span class="sum-title">Education</span>
          <span class="sum-icon" aria-hidden="true">+</span>
        </summary>
        <div class="card-body">
          <ul>
            <li>Universität der Künste Berlin (MA Oper), Apr 2024 to Jul 2026 (expected)</li>
            <li>Korea National Opera Studio (Young Artist), Feb 2022 to Feb 2023</li>
            <li>Seoul National University College of Music (BM Voice Performance), Mar 2017 to Feb 2021, graduated with honours</li>
            <li>Gimcheon Arts High School, full scholarship, graduated as valedictorian, Mar 2014 to Feb 2017</li>
          </ul>
        </div>
      </details>

      <details class="card">
        <summary>
          <span class="sum-title">Awards and Scholarships</span>
          <span class="sum-icon" aria-hidden="true">+</span>
        </summary>
        <div class="card-body">
          <ul>
            <li>2025 Lembcke Ad-Infinitum Foundation, scholarship</li>
            <li>2025 Lucia-Loeser-Stiftung, scholarship</li>
            <li>2022 Korea National Opera, Opera Studio Artist</li>
            <li>2022 Pavarotti Voice concours, 1st Prize</li>
            <li>2021 Pavarotti Foundation, scholarship</li>
            <li>2018 Seoul National University work-study, scholarship</li>
            <li>2017 Hyundai Motor Chung Mong Koo, OnDream Ensemble member</li>
            <li>2017 Hyundai Motor Chung Mong Koo Arts and Cultures, scholarship</li>
            <li>2017 Seoul National University merit-based, scholarship</li>
            <li>2016 National Suri Music Competition, 2nd Prize</li>
            <li>2016 Sung-Jeong Music Competition, 2nd Prize</li>
            <li>2016 Pavarotti Voice concours, 2nd Prize</li>
            <li>2015 Pavarotti Voice concours, 2nd Prize</li>
            <li>2015 Gyeong-Buk Music Association Competition, Grand Prize</li>
            <li>2015 Sung-Jeong Music Competition, 2nd Prize (no 1st Prize awarded)</li>
            <li>2013 TBC Music Concours, 1st Prize</li>
            <li>2013 Daegu Phil Concours, 1st Prize</li>
            <li>2013 Daegu Catholic University National Music Concours, 1st Prize</li>
            <li>2013 National Music Concours at Sungwoon University, 1st Prize</li>
          </ul>
        </div>
      </details>

      <details class="card">
        <summary>
          <span class="sum-title">Master Classes</span>
          <span class="sum-icon" aria-hidden="true">+</span>
        </summary>
        <div class="card-body">
          <ul>
            <li>2022 Soprano Young Mi Kim master class</li>
            <li>2019 Hyundai Motor Chung Mong Koo Foundation On Dream music camp</li>
            <li>2019 Soprano Olga Makarina master class</li>
            <li>2019 Soprano Sumi Hwang master class</li>
            <li>2019 Mezzo-soprano HyunJu Yoon master class</li>
            <li>2019 Soprano Ye-ri Seo master class</li>
            <li>2018 Hyundai Motor Chung Mong Koo Foundation On Dream music camp</li>
            <li>2017 Hyundai Motor Chung Mong Koo Foundation On Dream music camp</li>
            <li>2016 Baritone Jung Rokki master class</li>
            <li>2015 Soprano Hyewon Moon master class</li>
          </ul>
        </div>
      </details>

      <details class="card">
        <summary>
          <span class="sum-title">Teachers</span>
          <span class="sum-icon" aria-hidden="true">+</span>
        </summary>
        <div class="card-body teacher-grid">
          <div class="teacher-block">
            <h3>Voice</h3>
            <p>Deborah York, HyeonJae Park, Minok Choi, HaeJi Chang</p>
          </div>

          <div class="teacher-block">
            <h3>Piano accompaniment</h3>
            <p>Helen Collyer, Thorstan Kaldewei, Sebastian Stoermer, Hojeong Jung, EunA Bae</p>
          </div>

          <div class="teacher-block">
            <h3>Stage direction</h3>
            <p>Lars Franke, Thilo Reinhardt, Zsófia Geréb, Hyeonjin Pyo</p>
          </div>

          <div class="teacher-block">
            <h3>Theory and piano</h3>
            <p>Seokran Kwon, Inseon Kim, Soo Yong Seo</p>
          </div>
        </div>
      </details>

      <details class="card">
        <summary>
          <span class="sum-title">Languages</span>
          <span class="sum-icon" aria-hidden="true">+</span>
        </summary>
        <div class="card-body">
          <ul>
            <li>Korean (native)</li>
            <li>English (fluent)</li>
            <li>German (good knowledge, B2)</li>
          </ul>
        </div>
      </details>
    </section>
  </section>

  <p class="toast" id="toast" aria-live="polite"></p>

  <style>
    .cv-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 12px 0 44px;
    }

    .cv-hero {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 18px;
      padding: 4px 0 18px;
      border-bottom: 1px solid #d9d9d9;
      margin-bottom: 20px;
    }

    .cv-title {
      margin: 0;
      font-family: "Times New Roman", Times, serif;
      font-size: 32px;
      font-weight: 400;
      line-height: 1.15;
      color: #111111;
    }

    .cv-sub {
      margin: 8px 0 0;
      font-family: "Times New Roman", Times, serif;
      font-size: 17px;
      line-height: 1.6;
      color: #5f5f5f;
      max-width: 62ch;
    }

    
.cv-actions {
  display: flex;
  gap: 14px;
  align-items: center;
}

/* ICON STYLE */
.cv-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: 36px;
  height: 36px;

  color: #8a8a8a;
  background: transparent;
  border: none;
  cursor: pointer;

  transition: all 0.2s ease;
}

/* hover effect */
.cv-icon:hover {
  color: #111111;
  transform: translateY(-1px);
}

/* svg size */
.icon {
  width: 18px;
  height: 18px;
}
   
.icon {
  width: 18px;
  height: 18px;

  stroke: currentColor;
  fill: none; /* THIS is key */
}
    .card {
      border: 1px solid #d9d9d9;
      border-radius: 0;
      background: #ffffff;
    }
.cv-icon {
  color: #9a9a9a;
}

.cv-icon:hover {
  color: #111;
}
    .cv-preview {
      padding: 16px;
      margin-bottom: 14px;
    }

    .card-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }

    .card-head h2 {
      margin: 0;
      font-family: "Times New Roman", Times, serif;
      font-size: 24px;
      font-weight: 400;
      color: #111111;
    }

    .pdf-frame {
      width: 100%;
      overflow: hidden;
      border: 1px solid #e2e2e2;
      background: #fafafa;
    }

    .pdf-frame iframe {
      width: 100%;
      height: 520px;
      border: 0;
      display: block;
    }

    .cv-sections {
      display: grid;
      gap: 14px;
      margin-top: 6px;
    }

    details.card {
      padding: 0;
      overflow: hidden;
    }

    details summary {
      list-style: none;
      cursor: pointer;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      user-select: none;
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    .sum-title {
      font-family: "Times New Roman", Times, serif;
      font-size: 20px;
      font-weight: 400;
      color: #111111;
    }

    .sum-icon {
      font-family: "Times New Roman", Times, serif;
      font-size: 20px;
      line-height: 1;
      color: #777777;
      transition: transform 0.2s ease;
    }

    details[open] .sum-icon {
      transform: rotate(45deg);
    }

    .card-body {
      padding: 0 18px 18px;
    }

    ul {
      margin: 0;
      padding-left: 20px;
    }

    li {
      margin: 8px 0;
      font-family: "Times New Roman", Times, serif;
      font-size: 17px;
      line-height: 1.65;
      color: #2f2f2f;
    }

    .teacher-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .teacher-block h3 {
      margin: 0 0 6px;
      font-family: "Times New Roman", Times, serif;
      font-size: 18px;
      font-weight: 400;
      color: #111111;
    }

    .teacher-block p {
      margin: 0;
      font-family: "Times New Roman", Times, serif;
      font-size: 17px;
      line-height: 1.65;
      color: #2f2f2f;
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: 16px;
      transform: translateX(-50%);
      margin: 0;
      padding: 10px 14px;
      border: 1px solid #d9d9d9;
      background: #ffffff;
      font-family: "Times New Roman", Times, serif;
      font-size: 15px;
      color: #111111;
      opacity: 0;
      pointer-events: none;
      transition: opacity 160ms ease;
      max-width: 92vw;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .toast.show {
      opacity: 1;
    }

    @media (max-width: 900px) {
      .cv-hero {
        flex-direction: column;
        align-items: flex-start;
      }

      .cv-actions {
        width: 100%;
        justify-content: flex-start;
      }

      .teacher-grid {
        grid-template-columns: 1fr;
      }

      .pdf-frame iframe {
        height: 420px;
      }
    }

    @media (max-width: 640px) {
      .cv-title {
        font-size: 28px;
      }

      .cv-sub {
        font-size: 16px;
      }

      .card-head h2 {
        font-size: 22px;
      }

      .sum-title {
        font-size: 18px;
      }

      li,
      .teacher-block p {
        font-size: 16px;
      }

      .pdf-frame iframe {
        height: 340px;
      }
    }
  </style>

  <script>
    document.querySelectorAll("details.card").forEach((d) => d.removeAttribute("open"));

    const shareBtn = document.getElementById("shareBtn");
    const toast = document.getElementById("toast");

    function showToast(message) {
      toast.textContent = message;
      toast.classList.add("show");
      window.clearTimeout(window.__toastTimer);
      window.__toastTimer = window.setTimeout(() => {
        toast.classList.remove("show");
      }, 1600);
    }

    async function copyLink(url) {
      try {
        await navigator.clipboard.writeText(url);
        showToast("Link copied.");
      } catch (e) {
        showToast("Could not copy link.");
      }
    }

    shareBtn?.addEventListener("click", async () => {
      const url = window.location.href;
      const title = document.title;

      if (navigator.share) {
        try {
          await navigator.share({ title, url });
          return;
        } catch (e) {
          // fall back to copy
        }
      }

      await copyLink(url);
    });
  </script>
</BaseLayout>