---

import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "Rena Seulgi Jang | Soprano";
---

<BaseLayout title={title} lang="en">
  <section class="hero" aria-label="Homepage hero">
    <div class="hero-inner">
      <div class="soprano reveal r1">Soprano</div>

      <figure class="portrait-wrap reveal r2">
        <img
          class="portrait"
          src="/hero/portrait.jpg"
          alt="Portrait of Rena Seulgi Jang"
          loading="eager"
          decoding="async"
        />
      </figure>

      <div class="name reveal r3">Rena Seulgi Jang</div>
    </div>
  </section>

  <style>
    .hero {
      min-height: calc(100vh - 120px);
      display: grid;
      place-items: start center;
      padding: 36px 12px 34px;
      background: #ffffff;
    }

    .hero-inner {
      width: min(480px, 92vw);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .soprano {
      font-family: "Times New Roman", Times, serif;
      letter-spacing: 0.22em;
      font-size: 12px;
      color: #6f6f6f;
      margin-bottom: 18px;
      text-transform: uppercase;
    }

    .portrait-wrap {
      width: 100%;
      margin: 0;
      display: grid;
      place-items: center;
    }

    .portrait {
      width: 100%;
      max-width: 420px;
      height: auto;
      display: block;
      filter: grayscale(100%) contrast(1.02);
    }

    .name {
      margin-top: 18px;
      font-family: "Times New Roman", Times, serif;
      letter-spacing: 0.08em;
      font-size: 20px;
      color: #111111;
    }

    .reveal {
      opacity: 0;
      transform: translateY(6px);
      animation: fadeUp 0.7s ease forwards;
    }

    .r1 { animation-delay: 0.12s; }
    .r2 { animation-delay: 0.3s; }
    .r3 { animation-delay: 0.5s; }

    @keyframes fadeUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 960px) {
      .hero {
        min-height: auto;
        padding: 24px 10px 26px;
      }

      .portrait {
        max-width: 360px;
      }

      .name {
        font-size: 18px;
      }
    }

    @media (max-width: 420px) {
      .soprano {
        margin-bottom: 14px;
      }

      .name {
        margin-top: 14px;
      }

      .portrait {
        max-width: 300px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal {
        animation: none;
        opacity: 1;
        transform: none;
      }
    }
  </style>
</BaseLayout>