---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<!-- BANANA123 -->

<BaseLayout lang="en" current="home" title="Rena Seulgi Jang | Soprano">
  <section class="hero">
    <div class="text fade">
      <p class="role">Soprano</p>
      <h1>Rena Seulgi Jang</h1>

      <p class="intro">
        Opera singer based in Berlin.  
        Selected repertoire, performances, and media.
      </p>

      <div class="actions">
        <a class="btn primary" href="/en/media/">Media</a>
        <a class="btn" href="/en/cv/">Download CV</a>
      </div>
    </div>
  </section>

  <style>
    .hero {
      min-height: 64vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem 0 3rem;
    }

    .text {
      max-width: 560px;
    }

    .role {
      margin: 0 0 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      font-size: 0.75rem;
      opacity: 0.7;
    }

    h1 {
      margin: 0 0 1rem;
      font-size: clamp(2.6rem, 5vw, 4rem);
    }

    .intro {
      font-size: 1.05rem;
      margin-bottom: 1.8rem;
    }

    .actions {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.1rem;
      border-radius: 999px;
      border: 1px solid rgba(18, 18, 18, 0.16);
      text-decoration: none;
      font-weight: 600;
      background: rgba(255, 255, 255, 0.6);
    }

    .btn.primary {
      background: rgba(18, 18, 18, 0.92);
      color: #fff;
      border-color: rgba(18, 18, 18, 0.92);
    }

    /* Fade-in animation */
    .fade {
      opacity: 0;
      transform: translateY(10px);
      animation: fadeUp 800ms ease-out forwards;
    }

    @keyframes fadeUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 720px) {
      .hero {
        min-height: 55vh;
      }
    }
  </style>
</BaseLayout>
